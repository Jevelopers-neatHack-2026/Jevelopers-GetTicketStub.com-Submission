{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.jevelopers.org/ProductionBundleRef/1.0.0",
  "title": "ProductionBundleRef",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "contract": {
      "const": "ProductionBundleRef",
      "x-classification": "public"
    },
    "schema_version": {
      "const": "1.0.0",
      "x-classification": "public"
    },
    "policy_version": {
      "const": "1.0.0",
      "x-classification": "public"
    },
    "bundle_ref": {
      "allOf": [
        {
          "$ref": "https://schemas.jevelopers.org/ProductionReference/1.0.0#/$defs/Reference",
          "x-classification": "restricted"
        },
        {
          "type": "object",
          "properties": {
            "contract": {
              "const": "ProductionBundle",
              "x-classification": "public"
            },
            "schema_version": {
              "const": "2.0.0",
              "x-classification": "public"
            }
          },
          "required": [
            "contract",
            "schema_version"
          ]
        }
      ],
      "x-classification": "restricted"
    },
    "file_set": {
      "type": "array",
      "items": {
        "$ref": "https://schemas.jevelopers.org/ArtifactFile/2.0.0",
        "x-classification": "restricted"
      },
      "minItems": 4,
      "maxItems": 100,
      "x-classification": "restricted"
    },
    "detached_ref": {
      "allOf": [
        {
          "$ref": "https://schemas.jevelopers.org/ProductionReference/1.0.0#/$defs/Reference",
          "x-classification": "restricted"
        },
        {
          "type": "object",
          "properties": {
            "contract": {
              "const": "ProductionBundleDetached",
              "x-classification": "public"
            },
            "schema_version": {
              "const": "1.0.0",
              "x-classification": "public"
            }
          },
          "required": [
            "contract",
            "schema_version"
          ]
        }
      ],
      "x-classification": "restricted"
    },
    "row_scope": {
      "anyOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "job_ref": {
              "$ref": "https://schemas.jevelopers.org/JobRef/1.0.0",
              "x-classification": "restricted"
            },
            "row_id": {
              "type": "string",
              "pattern": "^[A-Za-z0-9_.:-]{1,100}(?![\\s\\S])",
              "x-classification": "restricted"
            },
            "ordinal": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9999,
              "x-classification": "restricted"
            },
            "input_hash": {
              "$ref": "https://schemas.jevelopers.org/CommonEnvelope/1.0.0#/$defs/Sha256",
              "x-classification": "restricted",
              "type": "string",
              "minLength": 71,
              "maxLength": 71
            }
          },
          "required": [
            "job_ref",
            "row_id",
            "ordinal",
            "input_hash"
          ],
          "x-classification": "restricted"
        },
        {
          "type": "null"
        }
      ],
      "x-classification": "restricted"
    },
    "composition_ref": {
      "allOf": [
        {
          "$ref": "https://schemas.jevelopers.org/ProductionReference/1.0.0#/$defs/Reference",
          "x-classification": "restricted"
        },
        {
          "type": "object",
          "properties": {
            "contract": {
              "const": "Composition",
              "x-classification": "public"
            },
            "schema_version": {
              "const": "1.0.0",
              "x-classification": "public"
            }
          },
          "required": [
            "contract",
            "schema_version"
          ]
        }
      ],
      "x-classification": "restricted"
    },
    "eligibility": {
      "$ref": "https://schemas.jevelopers.org/ProductionReference/1.0.0#/$defs/Eligibility",
      "x-classification": "restricted"
    }
  },
  "required": [
    "contract",
    "schema_version",
    "policy_version",
    "bundle_ref",
    "file_set",
    "detached_ref",
    "row_scope",
    "composition_ref",
    "eligibility"
  ],
  "x-classification": "restricted"
}
