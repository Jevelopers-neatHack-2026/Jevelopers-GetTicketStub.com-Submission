{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.jevelopers.org/cost-intelligence/budgets/PartialAcknowledgementRequestSchema/1.0.0",
  "x-schema-completeness": "complete",
  "additionalProperties": false,
  "type": "object",
  "required": [
    "schemaVersion",
    "requestId",
    "idempotencyKey",
    "scope",
    "reservationId",
    "expectedRevision",
    "actorReference",
    "attemptBinding",
    "sourceAuthorityRef",
    "allowedAmount",
    "allowedWorkUnits",
    "unit",
    "revisedPlanHash",
    "revisedPlan"
  ],
  "properties": {
    "schemaVersion": {
      "const": "1.0.0",
      "type": "string"
    },
    "requestId": {
      "minLength": 1,
      "maxLength": 256,
      "type": "string"
    },
    "idempotencyKey": {
      "minLength": 1,
      "maxLength": 256,
      "type": "string"
    },
    "scope": {
      "additionalProperties": false,
      "type": "object",
      "required": [
        "tenantId",
        "projectId",
        "environment",
        "billingMode",
        "actorId"
      ],
      "properties": {
        "tenantId": {
          "minLength": 1,
          "maxLength": 128,
          "type": "string"
        },
        "projectId": {
          "minLength": 1,
          "maxLength": 128,
          "type": "string"
        },
        "environment": {
          "anyOf": [
            {
              "const": "development",
              "type": "string"
            },
            {
              "const": "test",
              "type": "string"
            },
            {
              "const": "production",
              "type": "string"
            }
          ]
        },
        "billingMode": {
          "anyOf": [
            {
              "const": "live",
              "type": "string"
            },
            {
              "const": "sandbox",
              "type": "string"
            },
            {
              "const": "simulated",
              "type": "string"
            }
          ]
        },
        "actorId": {
          "minLength": 1,
          "maxLength": 128,
          "type": "string"
        }
      }
    },
    "reservationId": {
      "minLength": 1,
      "maxLength": 256,
      "type": "string"
    },
    "expectedRevision": {
      "minimum": 1,
      "type": "integer"
    },
    "actorReference": {
      "minLength": 1,
      "maxLength": 256,
      "type": "string"
    },
    "attemptBinding": {
      "additionalProperties": false,
      "type": "object",
      "required": [
        "logicalOperationId",
        "transportAttemptId",
        "providerRequestId",
        "providerAttemptId",
        "billableAttemptId"
      ],
      "properties": {
        "logicalOperationId": {
          "minLength": 1,
          "maxLength": 256,
          "type": "string"
        },
        "transportAttemptId": {
          "minLength": 1,
          "maxLength": 256,
          "type": "string"
        },
        "providerRequestId": {
          "anyOf": [
            {
              "minLength": 1,
              "maxLength": 256,
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "providerAttemptId": {
          "minLength": 1,
          "maxLength": 256,
          "type": "string"
        },
        "billableAttemptId": {
          "minLength": 1,
          "maxLength": 256,
          "type": "string"
        }
      }
    },
    "sourceAuthorityRef": {
      "additionalProperties": false,
      "type": "object",
      "required": [
        "contract",
        "schema_version",
        "id",
        "revision",
        "content_hash"
      ],
      "properties": {
        "contract": {
          "minLength": 1,
          "type": "string"
        },
        "schema_version": {
          "const": "1.0.0",
          "type": "string"
        },
        "id": {
          "minLength": 1,
          "type": "string"
        },
        "revision": {
          "minimum": 0,
          "type": "integer"
        },
        "content_hash": {
          "pattern": "^sha256:[a-f0-9]{64}$",
          "type": "string"
        }
      }
    },
    "allowedAmount": {
      "pattern": "^(?:0|[1-9][0-9]*)(?:\\.[0-9]{1,18})?$",
      "maxLength": 40,
      "description": "Non-negative base-10 decimal string with at most 18 fractional digits.",
      "type": "string"
    },
    "allowedWorkUnits": {
      "minimum": 1,
      "type": "integer"
    },
    "unit": {
      "minLength": 1,
      "maxLength": 256,
      "type": "string"
    },
    "revisedPlanHash": {
      "pattern": "^sha256:[a-f0-9]{64}$",
      "type": "string"
    },
    "revisedPlan": {
      "additionalProperties": false,
      "type": "object",
      "required": [
        "requestedUnits",
        "unit",
        "unitMaximumAmount"
      ],
      "properties": {
        "requestedUnits": {
          "minimum": 1,
          "maximum": 2147483647,
          "type": "integer"
        },
        "unit": {
          "minLength": 1,
          "maxLength": 256,
          "type": "string"
        },
        "unitMaximumAmount": {
          "pattern": "^(?:0|[1-9][0-9]*)(?:\\.[0-9]{1,18})?$",
          "maxLength": 40,
          "description": "Non-negative base-10 decimal string with at most 18 fractional digits.",
          "type": "string"
        }
      }
    }
  }
}
