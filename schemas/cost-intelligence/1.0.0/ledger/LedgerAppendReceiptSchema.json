{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.jevelopers.org/cost-intelligence/ledger/LedgerAppendReceiptSchema/1.0.0",
  "x-schema-completeness": "complete",
  "additionalProperties": false,
  "type": "object",
  "required": [
    "schemaVersion",
    "requestId",
    "status",
    "eventId",
    "existingEventId",
    "durableCommit",
    "ingestedAt"
  ],
  "properties": {
    "schemaVersion": {
      "const": "1.0.0",
      "type": "string"
    },
    "requestId": {
      "minLength": 1,
      "maxLength": 128,
      "type": "string"
    },
    "status": {
      "anyOf": [
        {
          "const": "accepted",
          "type": "string"
        },
        {
          "const": "duplicate",
          "type": "string"
        },
        {
          "const": "conflict",
          "type": "string"
        },
        {
          "const": "stale_revision",
          "type": "string"
        }
      ]
    },
    "eventId": {
      "minLength": 1,
      "maxLength": 256,
      "type": "string"
    },
    "existingEventId": {
      "anyOf": [
        {
          "minLength": 1,
          "maxLength": 256,
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "durableCommit": {
      "type": "boolean"
    },
    "ingestedAt": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    }
  }
}
