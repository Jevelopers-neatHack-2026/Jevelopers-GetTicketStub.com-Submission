{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.jevelopers.org/cost-intelligence/reconciliation/CoverageSnapshotReferenceSchema/1.0.0",
  "x-schema-completeness": "complete",
  "additionalProperties": false,
  "type": "object",
  "required": [
    "sourceId",
    "importId",
    "revision",
    "contentHash"
  ],
  "properties": {
    "sourceId": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
      "maxLength": 128,
      "type": "string"
    },
    "importId": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
      "maxLength": 128,
      "type": "string"
    },
    "revision": {
      "minimum": 1,
      "maximum": 9007199254740991,
      "type": "integer"
    },
    "contentHash": {
      "pattern": "^sha256:[a-f0-9]{64}$",
      "type": "string"
    }
  }
}
