{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.jevelopers.org/cost-intelligence/pricing/ExactRatioSchema/1.0.0",
  "x-schema-completeness": "complete",
  "additionalProperties": false,
  "type": "object",
  "required": [
    "numerator",
    "denominator"
  ],
  "properties": {
    "numerator": {
      "pattern": "^-?(?:0|[1-9][0-9]*)$",
      "maxLength": 8192,
      "type": "string"
    },
    "denominator": {
      "pattern": "^[1-9][0-9]*$",
      "maxLength": 8192,
      "type": "string"
    }
  }
}
