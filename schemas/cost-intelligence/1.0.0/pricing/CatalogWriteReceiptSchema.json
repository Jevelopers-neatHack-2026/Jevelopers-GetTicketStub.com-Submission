{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.jevelopers.org/cost-intelligence/pricing/CatalogWriteReceiptSchema/1.0.0",
  "x-schema-completeness": "complete",
  "additionalProperties": false,
  "type": "object",
  "required": [
    "schemaVersion",
    "requestId",
    "status",
    "reference",
    "durableCommit"
  ],
  "properties": {
    "schemaVersion": {
      "const": "1.0.0",
      "type": "string"
    },
    "requestId": {
      "minLength": 1,
      "type": "string"
    },
    "status": {
      "anyOf": [
        {
          "const": "accepted",
          "type": "string"
        },
        {
          "const": "duplicate",
          "type": "string"
        }
      ]
    },
    "reference": {
      "additionalProperties": false,
      "type": "object",
      "required": [
        "contract",
        "schema_version",
        "id",
        "revision",
        "content_hash"
      ],
      "properties": {
        "contract": {
          "minLength": 1,
          "maxLength": 128,
          "type": "string"
        },
        "schema_version": {
          "const": "1.0.0",
          "type": "string"
        },
        "id": {
          "minLength": 1,
          "maxLength": 128,
          "type": "string"
        },
        "revision": {
          "minimum": 1,
          "type": "integer"
        },
        "content_hash": {
          "pattern": "^sha256:[a-f0-9]{64}$",
          "type": "string"
        }
      }
    },
    "durableCommit": {
      "type": "boolean"
    }
  }
}
