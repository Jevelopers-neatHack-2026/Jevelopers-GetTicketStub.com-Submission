{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.jevelopers.org/cost-intelligence/pricing/VersionedReferenceSchema/2.0.0",
  "x-schema-completeness": "complete",
  "additionalProperties": false,
  "type": "object",
  "required": [
    "contract",
    "schema_version",
    "id",
    "revision",
    "content_hash"
  ],
  "properties": {
    "contract": {
      "minLength": 1,
      "maxLength": 128,
      "type": "string"
    },
    "schema_version": {
      "const": "2.0.0",
      "type": "string"
    },
    "id": {
      "minLength": 1,
      "maxLength": 128,
      "type": "string"
    },
    "revision": {
      "minimum": 1,
      "type": "integer"
    },
    "content_hash": {
      "pattern": "^sha256:[a-f0-9]{64}$",
      "type": "string"
    }
  }
}
