{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.jevelopers.org/cost-intelligence/pricing/RegisterRateCardRequestSchema/2.0.0",
  "x-schema-completeness": "partial_wrapper_requires_combined_validation",
  "x-combined-validator": "validateRateCardV2Boundary",
  "additionalProperties": false,
  "type": "object",
  "required": [
    "schemaVersion",
    "requestId",
    "idempotencyKey",
    "scope",
    "rateCard"
  ],
  "properties": {
    "schemaVersion": {
      "const": "2.0.0",
      "type": "string"
    },
    "requestId": {
      "minLength": 1,
      "maxLength": 128,
      "type": "string"
    },
    "idempotencyKey": {
      "minLength": 1,
      "maxLength": 200,
      "type": "string"
    },
    "scope": {
      "additionalProperties": false,
      "type": "object",
      "required": [
        "tenantId",
        "projectId",
        "environment",
        "billingMode",
        "actorId"
      ],
      "properties": {
        "tenantId": {
          "minLength": 1,
          "maxLength": 128,
          "type": "string"
        },
        "projectId": {
          "minLength": 1,
          "maxLength": 128,
          "type": "string"
        },
        "environment": {
          "anyOf": [
            {
              "const": "development",
              "type": "string"
            },
            {
              "const": "test",
              "type": "string"
            },
            {
              "const": "production",
              "type": "string"
            }
          ]
        },
        "billingMode": {
          "anyOf": [
            {
              "const": "live",
              "type": "string"
            },
            {
              "const": "sandbox",
              "type": "string"
            },
            {
              "const": "simulated",
              "type": "string"
            }
          ]
        },
        "actorId": {
          "minLength": 1,
          "maxLength": 128,
          "type": "string"
        }
      }
    },
    "rateCard": {
      "additionalProperties": false,
      "type": "object",
      "required": [
        "schemaVersion",
        "id",
        "revision",
        "provider",
        "product",
        "modelOrSku",
        "aliases",
        "contextTier",
        "serviceTier",
        "reasoningMode",
        "toolClass",
        "currency",
        "pricingRuleRef",
        "unitRates",
        "effectiveFrom",
        "effectiveTo",
        "retrievedAt",
        "freshnessMaxAgeSeconds",
        "sourceUrl",
        "sourceContentHash",
        "approvalRef",
        "provenance"
      ],
      "properties": {
        "schemaVersion": {
          "const": "2.0.0",
          "type": "string"
        },
        "id": {
          "minLength": 1,
          "maxLength": 128,
          "type": "string"
        },
        "revision": {
          "minimum": 1,
          "type": "integer"
        },
        "provider": {
          "minLength": 1,
          "maxLength": 128,
          "type": "string"
        },
        "product": {
          "minLength": 1,
          "maxLength": 128,
          "type": "string"
        },
        "modelOrSku": {
          "minLength": 1,
          "maxLength": 128,
          "type": "string"
        },
        "aliases": {
          "maxItems": 100,
          "type": "array",
          "items": {
            "minLength": 1,
            "maxLength": 128,
            "type": "string"
          }
        },
        "contextTier": {
          "anyOf": [
            {
              "minLength": 1,
              "maxLength": 128,
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "serviceTier": {
          "anyOf": [
            {
              "minLength": 1,
              "maxLength": 128,
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "reasoningMode": {
          "anyOf": [
            {
              "minLength": 1,
              "maxLength": 128,
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "toolClass": {
          "anyOf": [
            {
              "minLength": 1,
              "maxLength": 128,
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "currency": {
          "pattern": "^[A-Z]{3}$",
          "type": "string"
        },
        "pricingRuleRef": {
          "additionalProperties": false,
          "type": "object",
          "required": [
            "contract",
            "schema_version",
            "id",
            "revision",
            "content_hash"
          ],
          "properties": {
            "contract": {
              "minLength": 1,
              "maxLength": 128,
              "type": "string"
            },
            "schema_version": {
              "const": "2.0.0",
              "type": "string"
            },
            "id": {
              "minLength": 1,
              "maxLength": 128,
              "type": "string"
            },
            "revision": {
              "minimum": 1,
              "type": "integer"
            },
            "content_hash": {
              "pattern": "^sha256:[a-f0-9]{64}$",
              "type": "string"
            }
          }
        },
        "unitRates": {
          "minItems": 1,
          "maxItems": 100,
          "type": "array",
          "items": {
            "additionalProperties": false,
            "type": "object",
            "required": [
              "category",
              "unit",
              "basisQuantity",
              "rate",
              "relation"
            ],
            "properties": {
              "category": {
                "minLength": 1,
                "maxLength": 128,
                "type": "string"
              },
              "unit": {
                "minLength": 1,
                "maxLength": 128,
                "type": "string"
              },
              "basisQuantity": {
                "pattern": "^(?:0|[1-9][0-9]*)(?:\\.[0-9]{1,18})?$",
                "maxLength": 40,
                "description": "Non-negative base-10 decimal string with at most 18 fractional digits.",
                "type": "string"
              },
              "rate": {
                "pattern": "^(?:0|[1-9][0-9]*)(?:\\.[0-9]{1,18})?$",
                "maxLength": 40,
                "description": "Non-negative base-10 decimal string with at most 18 fractional digits.",
                "type": "string"
              },
              "relation": {
                "anyOf": [
                  {
                    "const": "standalone",
                    "type": "string"
                  },
                  {
                    "const": "included_subset",
                    "type": "string"
                  },
                  {
                    "const": "unknown_relation",
                    "type": "string"
                  }
                ]
              },
              "includedIn": {
                "minLength": 1,
                "maxLength": 128,
                "type": "string"
              }
            }
          }
        },
        "effectiveFrom": {
          "format": "date-time",
          "pattern": "Z$",
          "type": "string"
        },
        "effectiveTo": {
          "anyOf": [
            {
              "format": "date-time",
              "pattern": "Z$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "retrievedAt": {
          "format": "date-time",
          "pattern": "Z$",
          "type": "string"
        },
        "freshnessMaxAgeSeconds": {
          "minimum": 0,
          "maximum": 315360000,
          "type": "integer"
        },
        "sourceUrl": {
          "format": "uri",
          "maxLength": 2048,
          "type": "string"
        },
        "sourceContentHash": {
          "pattern": "^sha256:[a-f0-9]{64}$",
          "type": "string"
        },
        "approvalRef": {
          "additionalProperties": false,
          "type": "object",
          "required": [
            "contract",
            "schema_version",
            "id",
            "revision",
            "content_hash"
          ],
          "properties": {
            "contract": {
              "minLength": 1,
              "maxLength": 128,
              "type": "string"
            },
            "schema_version": {
              "const": "1.0.0",
              "type": "string"
            },
            "id": {
              "minLength": 1,
              "maxLength": 128,
              "type": "string"
            },
            "revision": {
              "minimum": 1,
              "type": "integer"
            },
            "content_hash": {
              "pattern": "^sha256:[a-f0-9]{64}$",
              "type": "string"
            }
          }
        },
        "provenance": {
          "anyOf": [
            {
              "const": "synthetic_fixture",
              "type": "string"
            },
            {
              "const": "documented_tariff",
              "type": "string"
            },
            {
              "const": "owner_approved",
              "type": "string"
            }
          ]
        }
      }
    }
  }
}
