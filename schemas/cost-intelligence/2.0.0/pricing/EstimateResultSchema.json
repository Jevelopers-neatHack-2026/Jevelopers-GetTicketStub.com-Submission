{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.jevelopers.org/cost-intelligence/pricing/EstimateResultSchema/2.0.0",
  "x-schema-completeness": "complete",
  "additionalProperties": false,
  "type": "object",
  "required": [
    "schemaVersion",
    "requestId",
    "estimatedAt",
    "status",
    "selectionPolicy",
    "effectiveAt",
    "knownSubtotal",
    "knownSubtotalExact",
    "currency",
    "rateCardRef",
    "pricingRuleRef",
    "fxRateRef",
    "fxConvertedSubtotal",
    "fxConvertedSubtotalExact",
    "fxTargetCurrency",
    "missingDimensions",
    "assumptions",
    "boundedConservativeAuthorizationAmount",
    "boundedConservativeAuthorizationAmountExact",
    "calculation"
  ],
  "properties": {
    "schemaVersion": {
      "const": "2.0.0",
      "type": "string"
    },
    "requestId": {
      "minLength": 1,
      "type": "string"
    },
    "estimatedAt": {
      "format": "date-time",
      "pattern": "Z$",
      "type": "string"
    },
    "status": {
      "anyOf": [
        {
          "const": "complete",
          "type": "string"
        },
        {
          "const": "partial",
          "type": "string"
        },
        {
          "const": "unknown",
          "type": "string"
        },
        {
          "const": "stale",
          "type": "string"
        },
        {
          "const": "pricing_unknown",
          "type": "string"
        }
      ]
    },
    "selectionPolicy": {
      "anyOf": [
        {
          "const": "event_time",
          "type": "string"
        },
        {
          "const": "contract_time",
          "type": "string"
        }
      ]
    },
    "effectiveAt": {
      "format": "date-time",
      "pattern": "Z$",
      "type": "string"
    },
    "knownSubtotal": {
      "anyOf": [
        {
          "pattern": "^-?(?:0|[1-9][0-9]*)(?:\\.[0-9]{1,18})?$",
          "maxLength": 40,
          "description": "Base-10 decimal string with at most 18 fractional digits; never use binary floating point for money.",
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "knownSubtotalExact": {
      "anyOf": [
        {
          "additionalProperties": false,
          "type": "object",
          "required": [
            "numerator",
            "denominator"
          ],
          "properties": {
            "numerator": {
              "pattern": "^-?(?:0|[1-9][0-9]*)$",
              "maxLength": 8192,
              "type": "string"
            },
            "denominator": {
              "pattern": "^[1-9][0-9]*$",
              "maxLength": 8192,
              "type": "string"
            }
          }
        },
        {
          "type": "null"
        }
      ]
    },
    "currency": {
      "anyOf": [
        {
          "pattern": "^[A-Z]{3}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "rateCardRef": {
      "anyOf": [
        {
          "additionalProperties": false,
          "type": "object",
          "required": [
            "contract",
            "schema_version",
            "id",
            "revision",
            "content_hash"
          ],
          "properties": {
            "contract": {
              "minLength": 1,
              "maxLength": 128,
              "type": "string"
            },
            "schema_version": {
              "const": "2.0.0",
              "type": "string"
            },
            "id": {
              "minLength": 1,
              "maxLength": 128,
              "type": "string"
            },
            "revision": {
              "minimum": 1,
              "type": "integer"
            },
            "content_hash": {
              "pattern": "^sha256:[a-f0-9]{64}$",
              "type": "string"
            }
          }
        },
        {
          "type": "null"
        }
      ]
    },
    "pricingRuleRef": {
      "anyOf": [
        {
          "additionalProperties": false,
          "type": "object",
          "required": [
            "contract",
            "schema_version",
            "id",
            "revision",
            "content_hash"
          ],
          "properties": {
            "contract": {
              "minLength": 1,
              "maxLength": 128,
              "type": "string"
            },
            "schema_version": {
              "const": "2.0.0",
              "type": "string"
            },
            "id": {
              "minLength": 1,
              "maxLength": 128,
              "type": "string"
            },
            "revision": {
              "minimum": 1,
              "type": "integer"
            },
            "content_hash": {
              "pattern": "^sha256:[a-f0-9]{64}$",
              "type": "string"
            }
          }
        },
        {
          "type": "null"
        }
      ]
    },
    "fxRateRef": {
      "anyOf": [
        {
          "additionalProperties": false,
          "type": "object",
          "required": [
            "contract",
            "schema_version",
            "id",
            "revision",
            "content_hash"
          ],
          "properties": {
            "contract": {
              "minLength": 1,
              "maxLength": 128,
              "type": "string"
            },
            "schema_version": {
              "const": "2.0.0",
              "type": "string"
            },
            "id": {
              "minLength": 1,
              "maxLength": 128,
              "type": "string"
            },
            "revision": {
              "minimum": 1,
              "type": "integer"
            },
            "content_hash": {
              "pattern": "^sha256:[a-f0-9]{64}$",
              "type": "string"
            }
          }
        },
        {
          "type": "null"
        }
      ]
    },
    "fxConvertedSubtotal": {
      "anyOf": [
        {
          "pattern": "^-?(?:0|[1-9][0-9]*)(?:\\.[0-9]{1,18})?$",
          "maxLength": 40,
          "description": "Base-10 decimal string with at most 18 fractional digits; never use binary floating point for money.",
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "fxConvertedSubtotalExact": {
      "anyOf": [
        {
          "additionalProperties": false,
          "type": "object",
          "required": [
            "numerator",
            "denominator"
          ],
          "properties": {
            "numerator": {
              "pattern": "^-?(?:0|[1-9][0-9]*)$",
              "maxLength": 8192,
              "type": "string"
            },
            "denominator": {
              "pattern": "^[1-9][0-9]*$",
              "maxLength": 8192,
              "type": "string"
            }
          }
        },
        {
          "type": "null"
        }
      ]
    },
    "fxTargetCurrency": {
      "anyOf": [
        {
          "pattern": "^[A-Z]{3}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "missingDimensions": {
      "maxItems": 100,
      "type": "array",
      "items": {
        "minLength": 1,
        "maxLength": 200,
        "type": "string"
      }
    },
    "assumptions": {
      "maxItems": 100,
      "type": "array",
      "items": {
        "minLength": 1,
        "maxLength": 3000,
        "type": "string"
      }
    },
    "boundedConservativeAuthorizationAmount": {
      "anyOf": [
        {
          "pattern": "^-?(?:0|[1-9][0-9]*)(?:\\.[0-9]{1,18})?$",
          "maxLength": 40,
          "description": "Base-10 decimal string with at most 18 fractional digits; never use binary floating point for money.",
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "boundedConservativeAuthorizationAmountExact": {
      "anyOf": [
        {
          "additionalProperties": false,
          "type": "object",
          "required": [
            "numerator",
            "denominator"
          ],
          "properties": {
            "numerator": {
              "pattern": "^-?(?:0|[1-9][0-9]*)$",
              "maxLength": 8192,
              "type": "string"
            },
            "denominator": {
              "pattern": "^[1-9][0-9]*$",
              "maxLength": 8192,
              "type": "string"
            }
          }
        },
        {
          "type": "null"
        }
      ]
    },
    "calculation": {
      "maxItems": 100,
      "type": "array",
      "items": {
        "additionalProperties": false,
        "type": "object",
        "required": [
          "usageUnit",
          "category",
          "quantity",
          "unit",
          "basisQuantity",
          "rate",
          "exactAmount",
          "extendedAmount",
          "relation"
        ],
        "properties": {
          "usageUnit": {
            "minLength": 1,
            "maxLength": 128,
            "type": "string"
          },
          "category": {
            "minLength": 1,
            "maxLength": 128,
            "type": "string"
          },
          "quantity": {
            "pattern": "^(?:0|[1-9][0-9]*)(?:\\.[0-9]{1,18})?$",
            "maxLength": 40,
            "description": "Non-negative base-10 decimal string with at most 18 fractional digits.",
            "type": "string"
          },
          "unit": {
            "minLength": 1,
            "maxLength": 128,
            "type": "string"
          },
          "basisQuantity": {
            "pattern": "^(?:0|[1-9][0-9]*)(?:\\.[0-9]{1,18})?$",
            "maxLength": 40,
            "description": "Non-negative base-10 decimal string with at most 18 fractional digits.",
            "type": "string"
          },
          "rate": {
            "pattern": "^(?:0|[1-9][0-9]*)(?:\\.[0-9]{1,18})?$",
            "maxLength": 40,
            "description": "Non-negative base-10 decimal string with at most 18 fractional digits.",
            "type": "string"
          },
          "exactAmount": {
            "additionalProperties": false,
            "type": "object",
            "required": [
              "numerator",
              "denominator"
            ],
            "properties": {
              "numerator": {
                "pattern": "^-?(?:0|[1-9][0-9]*)$",
                "maxLength": 8192,
                "type": "string"
              },
              "denominator": {
                "pattern": "^[1-9][0-9]*$",
                "maxLength": 8192,
                "type": "string"
              }
            }
          },
          "extendedAmount": {
            "pattern": "^-?(?:0|[1-9][0-9]*)(?:\\.[0-9]{1,18})?$",
            "maxLength": 40,
            "description": "Base-10 decimal string with at most 18 fractional digits; never use binary floating point for money.",
            "type": "string"
          },
          "relation": {
            "anyOf": [
              {
                "const": "standalone",
                "type": "string"
              },
              {
                "const": "included_subset",
                "type": "string"
              },
              {
                "const": "unknown_relation",
                "type": "string"
              }
            ]
          }
        }
      }
    }
  }
}
