{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.jevelopers.org/cost-intelligence/reconciliation/CoverageDryRunReadRequestSchema/2.0.0",
  "x-schema-completeness": "partial_wrapper_requires_combined_validation",
  "x-combined-validator": "validateCoverageDryRunReadRequestBoundary",
  "additionalProperties": false,
  "type": "object",
  "required": [
    "schemaVersion",
    "mode",
    "requestId",
    "scope",
    "runId",
    "pageSize"
  ],
  "properties": {
    "schemaVersion": {
      "const": "2.0.0",
      "type": "string"
    },
    "mode": {
      "const": "coverage_only",
      "type": "string"
    },
    "requestId": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
      "maxLength": 128,
      "type": "string"
    },
    "scope": {
      "additionalProperties": false,
      "type": "object",
      "required": [
        "tenantId",
        "projectId",
        "environment",
        "billingMode",
        "actorId"
      ],
      "properties": {
        "tenantId": {
          "minLength": 1,
          "maxLength": 128,
          "type": "string"
        },
        "projectId": {
          "minLength": 1,
          "maxLength": 128,
          "type": "string"
        },
        "environment": {
          "anyOf": [
            {
              "const": "development",
              "type": "string"
            },
            {
              "const": "test",
              "type": "string"
            },
            {
              "const": "production",
              "type": "string"
            }
          ]
        },
        "billingMode": {
          "anyOf": [
            {
              "const": "live",
              "type": "string"
            },
            {
              "const": "sandbox",
              "type": "string"
            },
            {
              "const": "simulated",
              "type": "string"
            }
          ]
        },
        "actorId": {
          "minLength": 1,
          "maxLength": 128,
          "type": "string"
        }
      }
    },
    "runId": {
      "pattern": "^sha256:[a-f0-9]{64}$",
      "type": "string"
    },
    "pageSize": {
      "minimum": 1,
      "maximum": 100,
      "type": "integer"
    },
    "cursor": {
      "pattern": "^[0-9]{1,3}:sha256:[a-f0-9]{64}$",
      "maxLength": 75,
      "type": "string"
    }
  }
}
