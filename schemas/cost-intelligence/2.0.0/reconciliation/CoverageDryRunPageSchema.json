{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.jevelopers.org/cost-intelligence/reconciliation/CoverageDryRunPageSchema/2.0.0",
  "x-schema-completeness": "complete",
  "additionalProperties": false,
  "type": "object",
  "required": [
    "schemaVersion",
    "mode",
    "status",
    "runId",
    "inputHash",
    "ruleVersion",
    "createdAt",
    "sourceCount",
    "ownerReference",
    "nextAction",
    "unavailableStages",
    "financialEffects",
    "billingAuthority",
    "coverage",
    "nextCursor"
  ],
  "properties": {
    "schemaVersion": {
      "const": "2.0.0",
      "type": "string"
    },
    "mode": {
      "const": "coverage_only",
      "type": "string"
    },
    "status": {
      "const": "needs_review",
      "type": "string"
    },
    "runId": {
      "pattern": "^sha256:[a-f0-9]{64}$",
      "type": "string"
    },
    "inputHash": {
      "pattern": "^sha256:[a-f0-9]{64}$",
      "type": "string"
    },
    "ruleVersion": {
      "const": "ci07-coverage-1.0.0",
      "type": "string"
    },
    "createdAt": {
      "format": "date-time",
      "maxLength": 40,
      "type": "string"
    },
    "sourceCount": {
      "minimum": 1,
      "maximum": 100,
      "type": "integer"
    },
    "ownerReference": {
      "minLength": 1,
      "maxLength": 128,
      "type": "string"
    },
    "nextAction": {
      "const": "review_coverage_and_supply_matching_and_apply_dependencies",
      "type": "string"
    },
    "unavailableStages": {
      "additionalProperties": false,
      "type": "object",
      "required": [
        "matching",
        "financialVariance",
        "apply",
        "settlement"
      ],
      "properties": {
        "matching": {
          "const": "unavailable",
          "type": "string"
        },
        "financialVariance": {
          "const": "unavailable",
          "type": "string"
        },
        "apply": {
          "const": "unavailable",
          "type": "string"
        },
        "settlement": {
          "const": "unavailable",
          "type": "string"
        }
      }
    },
    "financialEffects": {
      "const": false,
      "type": "boolean"
    },
    "billingAuthority": {
      "const": false,
      "type": "boolean"
    },
    "coverage": {
      "maxItems": 100,
      "type": "array",
      "items": {
        "additionalProperties": false,
        "type": "object",
        "required": [
          "reference",
          "record",
          "gaps"
        ],
        "properties": {
          "reference": {
            "additionalProperties": false,
            "type": "object",
            "required": [
              "sourceId",
              "importId",
              "revision",
              "contentHash"
            ],
            "properties": {
              "sourceId": {
                "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
                "maxLength": 128,
                "type": "string"
              },
              "importId": {
                "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
                "maxLength": 128,
                "type": "string"
              },
              "revision": {
                "minimum": 1,
                "maximum": 9007199254740991,
                "type": "integer"
              },
              "contentHash": {
                "pattern": "^sha256:[a-f0-9]{64}$",
                "type": "string"
              }
            }
          },
          "record": {
            "additionalProperties": false,
            "type": "object",
            "required": [
              "schemaVersion",
              "sourceId",
              "importId",
              "revision",
              "predecessorHash",
              "scope",
              "sourceAccountRef",
              "sourceProjectRef",
              "currency",
              "periodStart",
              "periodEnd",
              "timeZone",
              "coverageStart",
              "coverageEnd",
              "sourceArtifactHash",
              "adapterVersion",
              "sourceSchemaVersion",
              "cursorRef",
              "retrievedAt",
              "retrievalStatus",
              "recordCount",
              "zeroEvidenceRef",
              "evidenceMode",
              "verificationStatus"
            ],
            "properties": {
              "schemaVersion": {
                "const": "1.0.0",
                "type": "string"
              },
              "sourceId": {
                "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
                "maxLength": 128,
                "type": "string"
              },
              "importId": {
                "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
                "maxLength": 128,
                "type": "string"
              },
              "revision": {
                "minimum": 1,
                "maximum": 9007199254740991,
                "type": "integer"
              },
              "predecessorHash": {
                "anyOf": [
                  {
                    "pattern": "^sha256:[a-f0-9]{64}$",
                    "type": "string"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "scope": {
                "additionalProperties": false,
                "type": "object",
                "required": [
                  "tenantId",
                  "projectId",
                  "environment",
                  "billingMode"
                ],
                "properties": {
                  "tenantId": {
                    "minLength": 1,
                    "maxLength": 128,
                    "type": "string"
                  },
                  "projectId": {
                    "minLength": 1,
                    "maxLength": 128,
                    "type": "string"
                  },
                  "environment": {
                    "anyOf": [
                      {
                        "const": "development",
                        "type": "string"
                      },
                      {
                        "const": "test",
                        "type": "string"
                      },
                      {
                        "const": "production",
                        "type": "string"
                      }
                    ]
                  },
                  "billingMode": {
                    "anyOf": [
                      {
                        "const": "live",
                        "type": "string"
                      },
                      {
                        "const": "sandbox",
                        "type": "string"
                      },
                      {
                        "const": "simulated",
                        "type": "string"
                      }
                    ]
                  }
                }
              },
              "sourceAccountRef": {
                "anyOf": [
                  {
                    "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
                    "maxLength": 128,
                    "type": "string"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "sourceProjectRef": {
                "anyOf": [
                  {
                    "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
                    "maxLength": 128,
                    "type": "string"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "currency": {
                "anyOf": [
                  {
                    "pattern": "^[A-Z]{3}$",
                    "type": "string"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "periodStart": {
                "format": "date-time",
                "maxLength": 40,
                "type": "string"
              },
              "periodEnd": {
                "format": "date-time",
                "maxLength": 40,
                "type": "string"
              },
              "timeZone": {
                "minLength": 1,
                "maxLength": 64,
                "pattern": "^[A-Za-z0-9_+/-]+$",
                "type": "string"
              },
              "coverageStart": {
                "anyOf": [
                  {
                    "format": "date-time",
                    "maxLength": 40,
                    "type": "string"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "coverageEnd": {
                "anyOf": [
                  {
                    "format": "date-time",
                    "maxLength": 40,
                    "type": "string"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "sourceArtifactHash": {
                "anyOf": [
                  {
                    "pattern": "^sha256:[a-f0-9]{64}$",
                    "type": "string"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "adapterVersion": {
                "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
                "maxLength": 128,
                "type": "string"
              },
              "sourceSchemaVersion": {
                "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
                "maxLength": 128,
                "type": "string"
              },
              "cursorRef": {
                "anyOf": [
                  {
                    "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
                    "maxLength": 128,
                    "type": "string"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "retrievedAt": {
                "format": "date-time",
                "maxLength": 40,
                "type": "string"
              },
              "retrievalStatus": {
                "anyOf": [
                  {
                    "const": "complete",
                    "type": "string"
                  },
                  {
                    "const": "no_data",
                    "type": "string"
                  },
                  {
                    "const": "delayed",
                    "type": "string"
                  },
                  {
                    "const": "incomplete",
                    "type": "string"
                  },
                  {
                    "const": "explicit_zero",
                    "type": "string"
                  },
                  {
                    "const": "failed",
                    "type": "string"
                  }
                ]
              },
              "recordCount": {
                "anyOf": [
                  {
                    "minimum": 0,
                    "maximum": 9007199254740991,
                    "type": "integer"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "zeroEvidenceRef": {
                "anyOf": [
                  {
                    "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
                    "maxLength": 128,
                    "type": "string"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "evidenceMode": {
                "anyOf": [
                  {
                    "const": "mocked",
                    "type": "string"
                  },
                  {
                    "const": "sandbox",
                    "type": "string"
                  },
                  {
                    "const": "live",
                    "type": "string"
                  }
                ]
              },
              "verificationStatus": {
                "anyOf": [
                  {
                    "const": "verified",
                    "type": "string"
                  },
                  {
                    "const": "unverified",
                    "type": "string"
                  },
                  {
                    "const": "unknown",
                    "type": "string"
                  }
                ]
              }
            }
          },
          "gaps": {
            "uniqueItems": true,
            "type": "array",
            "items": {
              "anyOf": [
                {
                  "const": "source_account_unknown",
                  "type": "string"
                },
                {
                  "const": "source_project_unknown",
                  "type": "string"
                },
                {
                  "const": "currency_unknown",
                  "type": "string"
                },
                {
                  "const": "source_not_verified",
                  "type": "string"
                },
                {
                  "const": "incomplete_coverage",
                  "type": "string"
                },
                {
                  "const": "outside_requested_window",
                  "type": "string"
                },
                {
                  "const": "overlapping_coverage",
                  "type": "string"
                },
                {
                  "const": "revision_requires_review",
                  "type": "string"
                }
              ]
            }
          }
        }
      }
    },
    "nextCursor": {
      "anyOf": [
        {
          "pattern": "^[0-9]{1,3}:sha256:[a-f0-9]{64}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    }
  }
}
