{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.jevelopers.org/JobRef/1.0.0",
  "title": "JobRef",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "contract": {
      "const": "JobRef",
      "x-classification": "public"
    },
    "schema_version": {
      "const": "1.0.0",
      "x-classification": "public"
    },
    "policy_version": {
      "const": "1.0.0",
      "x-classification": "public"
    },
    "job_ref": {
      "allOf": [
        {
          "$ref": "https://schemas.jevelopers.org/ProductionReference/1.0.0#/$defs/Reference",
          "x-classification": "restricted"
        },
        {
          "type": "object",
          "properties": {
            "contract": {
              "const": "JobStatus",
              "x-classification": "public"
            },
            "schema_version": {
              "const": "1.0.0",
              "x-classification": "public"
            }
          },
          "required": [
            "contract",
            "schema_version"
          ]
        }
      ],
      "x-classification": "restricted"
    },
    "batch_input_hash": {
      "$ref": "https://schemas.jevelopers.org/CommonEnvelope/1.0.0#/$defs/Sha256",
      "x-classification": "restricted",
      "type": "string",
      "minLength": 71,
      "maxLength": 71
    }
  },
  "required": [
    "contract",
    "schema_version",
    "policy_version",
    "job_ref",
    "batch_input_hash"
  ],
  "x-classification": "restricted"
}
