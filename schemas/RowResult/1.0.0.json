{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.jevelopers.org/RowResult/1.0.0",
  "title": "RowResult",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "contract": {
      "const": "RowResult",
      "x-classification": "public"
    },
    "schema_version": {
      "const": "1.0.0",
      "x-classification": "public"
    },
    "policy_version": {
      "const": "1.0.0",
      "x-classification": "public"
    },
    "tenant_id": {
      "$ref": "https://schemas.jevelopers.org/CommonEnvelope/1.0.0#/$defs/TenantId",
      "x-classification": "restricted"
    },
    "project_id": {
      "$ref": "https://schemas.jevelopers.org/CommonEnvelope/1.0.0#/$defs/ProjectId",
      "x-classification": "restricted"
    },
    "job": {
      "$ref": "https://schemas.jevelopers.org/JobRef/1.0.0",
      "x-classification": "restricted"
    },
    "row_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_.:-]{1,100}(?![\\s\\S])",
      "x-classification": "restricted"
    },
    "ordinal": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9999,
      "x-classification": "restricted"
    },
    "input_hash": {
      "$ref": "https://schemas.jevelopers.org/CommonEnvelope/1.0.0#/$defs/Sha256",
      "x-classification": "restricted",
      "type": "string",
      "minLength": 71,
      "maxLength": 71
    },
    "status": {
      "type": "string",
      "enum": [
        "queued",
        "running",
        "succeeded",
        "failed",
        "cancelled",
        "skipped"
      ],
      "x-classification": "restricted"
    },
    "skip_reason": {
      "anyOf": [
        {
          "type": "string",
          "enum": [
            "SKIPPED_POLICY",
            "SKIPPED_CANCELLED"
          ],
          "x-classification": "restricted"
        },
        {
          "type": "null"
        }
      ],
      "x-classification": "restricted"
    },
    "artifact_ref": {
      "anyOf": [
        {
          "$ref": "https://schemas.jevelopers.org/ArtifactRef/1.0.0",
          "x-classification": "restricted"
        },
        {
          "type": "null"
        }
      ],
      "x-classification": "restricted"
    },
    "bundle_ref": {
      "anyOf": [
        {
          "$ref": "https://schemas.jevelopers.org/ProductionBundleRef/1.0.0",
          "x-classification": "restricted"
        },
        {
          "type": "null"
        }
      ],
      "x-classification": "restricted"
    },
    "errors": {
      "type": "array",
      "items": {
        "$ref": "https://schemas.jevelopers.org/ProductionError/1.0.0",
        "x-classification": "restricted"
      },
      "minItems": 0,
      "maxItems": 32,
      "x-classification": "restricted"
    },
    "source_position": {
      "anyOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "file_hash": {
              "$ref": "https://schemas.jevelopers.org/CommonEnvelope/1.0.0#/$defs/Sha256",
              "x-classification": "restricted",
              "type": "string",
              "minLength": 71,
              "maxLength": 71
            },
            "logical_record": {
              "type": "integer",
              "minimum": 1,
              "maximum": 10001,
              "x-classification": "restricted"
            },
            "physical_line": {
              "type": "integer",
              "minimum": 1,
              "maximum": 9007199254740991,
              "x-classification": "restricted"
            },
            "source_paths": {
              "type": "object",
              "maxProperties": 32,
              "propertyNames": {
                "type": "string",
                "pattern": "^[A-Za-z][A-Za-z0-9_.-]{0,63}(?![\\s\\S])"
              },
              "additionalProperties": {
                "type": "string",
                "maxLength": 256,
                "x-classification": "restricted"
              },
              "x-classification": "restricted"
            }
          },
          "required": [
            "file_hash",
            "logical_record",
            "physical_line",
            "source_paths"
          ],
          "x-classification": "restricted"
        },
        {
          "type": "null"
        }
      ],
      "x-classification": "restricted"
    },
    "eligibility": {
      "$ref": "https://schemas.jevelopers.org/ProductionReference/1.0.0#/$defs/Eligibility",
      "x-classification": "restricted"
    }
  },
  "required": [
    "contract",
    "schema_version",
    "policy_version",
    "tenant_id",
    "project_id",
    "job",
    "row_id",
    "ordinal",
    "input_hash",
    "status",
    "skip_reason",
    "artifact_ref",
    "bundle_ref",
    "errors",
    "source_position",
    "eligibility"
  ],
  "x-classification": "restricted"
}
