{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.jevelopers.org/ArtifactFile/2.0.0",
  "title": "ArtifactFile",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "contract": {
      "const": "ArtifactFile",
      "x-classification": "public"
    },
    "schema_version": {
      "const": "2.0.0",
      "x-classification": "public"
    },
    "policy_version": {
      "const": "1.0.0",
      "x-classification": "public"
    },
    "artifact_id": {
      "type": "string",
      "format": "uuid",
      "x-classification": "restricted",
      "minLength": 36,
      "maxLength": 36
    },
    "filename": {
      "type": "string",
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*(?![\\s\\S])",
      "x-classification": "restricted"
    },
    "role": {
      "type": "string",
      "enum": [
        "source_artwork",
        "display_preview",
        "composed_preview",
        "print_output",
        "preflight_report",
        "profile",
        "lineage",
        "manifest",
        "archive",
        "detached"
      ],
      "x-classification": "restricted"
    },
    "byte_hash": {
      "$ref": "https://schemas.jevelopers.org/CommonEnvelope/1.0.0#/$defs/Sha256",
      "x-classification": "restricted",
      "type": "string",
      "minLength": 71,
      "maxLength": 71
    },
    "byte_size": {
      "type": "integer",
      "minimum": 0,
      "maximum": 67108864,
      "x-classification": "restricted"
    },
    "media_type": {
      "type": "string",
      "enum": [
        "image/svg+xml",
        "image/png",
        "image/jpeg",
        "image/webp",
        "application/pdf",
        "application/json",
        "application/zip",
        "application/vnd.iccprofile"
      ],
      "x-classification": "restricted"
    },
    "geometry": {
      "anyOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "width_nm": {
              "type": "string",
              "pattern": "^[1-9][0-9]{0,9}(?![\\s\\S])",
              "x-classification": "restricted"
            },
            "height_nm": {
              "type": "string",
              "pattern": "^[1-9][0-9]{0,9}(?![\\s\\S])",
              "x-classification": "restricted"
            },
            "width_px": {
              "anyOf": [
                {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 1000000,
                  "x-classification": "restricted"
                },
                {
                  "type": "null"
                }
              ],
              "x-classification": "restricted"
            },
            "height_px": {
              "anyOf": [
                {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 1000000,
                  "x-classification": "restricted"
                },
                {
                  "type": "null"
                }
              ],
              "x-classification": "restricted"
            },
            "effective_dpi": {
              "anyOf": [
                {
                  "type": "number",
                  "exclusiveMinimum": 0,
                  "maximum": 9600,
                  "x-classification": "restricted"
                },
                {
                  "type": "null"
                }
              ],
              "x-classification": "restricted"
            }
          },
          "required": [
            "width_nm",
            "height_nm",
            "width_px",
            "height_px",
            "effective_dpi"
          ],
          "x-classification": "restricted"
        },
        {
          "type": "null"
        }
      ],
      "x-classification": "restricted"
    },
    "profile_ref": {
      "anyOf": [
        {
          "allOf": [
            {
              "$ref": "https://schemas.jevelopers.org/ProductionReference/1.0.0#/$defs/Reference",
              "x-classification": "restricted"
            },
            {
              "type": "object",
              "properties": {
                "contract": {
                  "const": "ProductionResource",
                  "x-classification": "public"
                },
                "schema_version": {
                  "const": "1.0.0",
                  "x-classification": "public"
                }
              },
              "required": [
                "contract",
                "schema_version"
              ]
            }
          ],
          "x-classification": "restricted"
        },
        {
          "type": "null"
        }
      ],
      "x-classification": "restricted"
    },
    "characteristics": {
      "anyOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "raster_artwork": {
              "type": "boolean",
              "x-classification": "restricted"
            },
            "text": {
              "type": "string",
              "enum": [
                "embedded",
                "rasterized",
                "none"
              ],
              "x-classification": "restricted"
            },
            "vector_content": {
              "type": "boolean",
              "x-classification": "restricted"
            },
            "alpha": {
              "type": "boolean",
              "x-classification": "restricted"
            }
          },
          "required": [
            "raster_artwork",
            "text",
            "vector_content",
            "alpha"
          ],
          "x-classification": "restricted"
        },
        {
          "type": "null"
        }
      ],
      "x-classification": "restricted"
    },
    "semantic_hash": {
      "anyOf": [
        {
          "$ref": "https://schemas.jevelopers.org/CommonEnvelope/1.0.0#/$defs/Sha256",
          "x-classification": "restricted",
          "type": "string",
          "minLength": 71,
          "maxLength": 71
        },
        {
          "type": "null"
        }
      ],
      "x-classification": "restricted"
    }
  },
  "required": [
    "contract",
    "schema_version",
    "policy_version",
    "artifact_id",
    "filename",
    "role",
    "byte_hash",
    "byte_size",
    "media_type",
    "geometry",
    "profile_ref",
    "characteristics",
    "semantic_hash"
  ],
  "x-classification": "restricted"
}
