    "idempotency_key": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_.:-]{1,128}(?![\\s\\S])",
      "x-classification": "restricted"
    },
    "disposition": {
      "type": "string",
      "enum": [
        "granted",
        "partially_granted",
        "denied",
        "unknown",
        "unavailable",
        "duplicate"
      ],
      "x-classification": "restricted"
    },
    "reservation": {
      "anyOf": [
        {
          "$ref": "https://schemas.jevelopers.org/BudgetReservation/2.0.0"
        },
        {
          "type": "null"
        }
      ],
      "x-classification": "restricted"
    },
    "error": {
      "anyOf": [
        {
          "$ref": "https://schemas.jevelopers.org/ErrorEnvelope/1.0.0#/$defs/ErrorDetail"
        },
        {
          "type": "null"
        }
      ],
      "x-classification": "restricted"
    },
    "finance_protocol_version": {
      "const": "2.0.0",
      "x-classification": "public"
    },
    "request_ref": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "contract": {
          "const": "ReserveRequest",
          "x-classification": "restricted"
        },
        "schema_version": {
          "const": "2.0.0",
          "x-classification": "restricted"
        },
        "id": {
          "type": "string",
          "format": "uuid",
          "x-classification": "restricted",
          "minLength": 36,
          "maxLength": 36
        },
        "revision": {
          "const": 1,
          "x-classification": "restricted"
        },
        "content_hash": {
          "$ref": "https://schemas.jevelopers.org/CommonEnvelope/1.0.0#/$defs/Sha256",
          "x-classification": "restricted",
          "type": "string",
          "minLength": 71,
          "maxLength": 71
        }
      },
      "required": [
        "contract",
        "schema_version",
        "id",
        "revision",
        "content_hash"
      ],
      "x-classification": "restricted"
    }
  },
  "required": [
    "contract",
    "schema_version",
    "policy_version",
    "event_id",
    "tenant_id",
    "project_id",
    "correlation_id",
    "producer",
    "occurred_at",
    "observed_at",
    "ingested_at",
    "environment",
    "billing_mode",
    "source_refs",
    "request_id",
    "idempotency_key",
    "disposition",
    "reservation",
    "error",
    "finance_protocol_version",
    "request_ref"
  ],
  "description": "Finance protocol 2.0.0 proposal; cumulative observed cost is separate from immutable authorized capacity. Legacy 1.0.0 bytes are retained without new safety guarantees."
}
