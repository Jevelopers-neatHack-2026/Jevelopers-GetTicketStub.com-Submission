{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.jevelopers.org/UsageEvent/2.0.0",
  "title": "UsageEvent",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "contract": {
      "const": "UsageEvent",
      "x-classification": "public"
    },
    "schema_version": {
      "const": "2.0.0",
      "x-classification": "public"
    },
    "policy_version": {
      "const": "1.0.0",
      "x-classification": "public"
    },
    "event_id": {
      "$ref": "https://schemas.jevelopers.org/CommonEnvelope/1.0.0#/$defs/EventId",
      "x-classification": "internal"
    },
    "tenant_id": {
      "$ref": "https://schemas.jevelopers.org/CommonEnvelope/1.0.0#/$defs/TenantId",
      "x-classification": "restricted"
    },
    "project_id": {
      "$ref": "https://schemas.jevelopers.org/CommonEnvelope/1.0.0#/$defs/ProjectId",
      "x-classification": "restricted"
    },
    "workflow_id": {
      "$ref": "https://schemas.jevelopers.org/CommonEnvelope/1.0.0#/$defs/WorkflowId",
      "x-classification": "internal"
    },
    "run_id": {
      "$ref": "https://schemas.jevelopers.org/CommonEnvelope/1.0.0#/$defs/RunId",
      "x-classification": "internal"
    },
    "job_id": {
      "$ref": "https://schemas.jevelopers.org/CommonEnvelope/1.0.0#/$defs/JobId",
      "x-classification": "internal"
    },
    "artifact_id": {
      "$ref": "https://schemas.jevelopers.org/CommonEnvelope/1.0.0#/$defs/ArtifactId",
      "x-classification": "restricted"
    },
    "design_id": {
      "$ref": "https://schemas.jevelopers.org/CommonEnvelope/1.0.0#/$defs/DesignId",
      "x-classification": "restricted"
    },
    "design_version_id": {
      "$ref": "https://schemas.jevelopers.org/CommonEnvelope/1.0.0#/$defs/DesignVersionId",
      "x-classification": "restricted"
    },
    "order_id": {
      "$ref": "https://schemas.jevelopers.org/CommonEnvelope/1.0.0#/$defs/OrderId",
      "x-classification": "restricted"
    },
    "trace_id": {
      "$ref": "https://schemas.jevelopers.org/CommonEnvelope/1.0.0#/$defs/TraceId",
      "x-classification": "internal"
    },
    "correlation_id": {
      "$ref": "https://schemas.jevelopers.org/CommonEnvelope/1.0.0#/$defs/CorrelationId",
      "x-classification": "internal"
    },
    "evidence_id": {
      "$ref": "https://schemas.jevelopers.org/CommonEnvelope/1.0.0#/$defs/EvidenceId",
      "x-classification": "internal"
    },
    "usage_event_id": {
      "$ref": "https://schemas.jevelopers.org/CommonEnvelope/1.0.0#/$defs/UsageEventId",
      "x-classification": "restricted"
    },
    "logical_operation_id": {
      "$ref": "https://schemas.jevelopers.org/CommonEnvelope/1.0.0#/$defs/LogicalOperationId",
      "x-classification": "restricted"
    },
    "provider_attempt_id": {
      "$ref": "https://schemas.jevelopers.org/CommonEnvelope/1.0.0#/$defs/ProviderAttemptId",
      "x-classification": "restricted"
    },
    "billable_attempt_id": {
      "$ref": "https://schemas.jevelopers.org/CommonEnvelope/1.0.0#/$defs/BillableAttemptId",
      "x-classification": "restricted"
    },
    "transport_attempt_id": {
      "$ref": "https://schemas.jevelopers.org/CommonEnvelope/1.0.0#/$defs/TransportAttemptId",
      "x-classification": "restricted"
    },
    "provider_request_id": {
      "$ref": "https://schemas.jevelopers.org/CommonEnvelope/1.0.0#/$defs/ProviderRequestId",
      "x-classification": "restricted"
    },
    "producer": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "module",
        "source_revision",
        "build_revision"
      ],
      "x-classification": "internal",
      "properties": {
        "module": {
          "type": "string",
          "enum": [
            "getticketstub.com",
            "agent-harness",
            "event-intelligence",
            "creative-engine",
            "print-production",
            "fulfillment-connectors",
            "cost-intelligence",
            "team-dashboard",
            "integration-evals",
            "shared-contracts"
          ],
          "x-classification": "public"
        },
        "source_revision": {
          "$ref": "https://schemas.jevelopers.org/CommonEnvelope/1.0.0#/$defs/SourceRevision",
          "x-classification": "public",
          "type": "string",
          "minLength": 40,
          "maxLength": 40
        },
        "build_revision": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_.-]{1,128}(?![\\s\\S])",
          "x-classification": "internal"
        }
      }
    },
    "occurred_at": {
      "$ref": "https://schemas.jevelopers.org/CommonEnvelope/1.0.0#/$defs/UtcTime",
      "x-classification": "internal",
      "type": "string",
      "pattern": "Z(?![\\s\\S])"
    },
    "observed_at": {
      "$ref": "https://schemas.jevelopers.org/CommonEnvelope/1.0.0#/$defs/UtcTime",
      "x-classification": "internal",
      "type": "string",
      "pattern": "Z(?![\\s\\S])"
    },
    "ingested_at": {
      "$ref": "https://schemas.jevelopers.org/CommonEnvelope/1.0.0#/$defs/UtcTime",
      "x-classification": "internal",
      "type": "string",
      "pattern": "Z(?![\\s\\S])"
    },
    "environment": {
      "type": "string",
      "enum": [
        "development",
        "test",
        "production"
      ],
      "x-classification": "public"
    },
    "billing_mode": {
      "type": "string",
      "enum": [
        "live",
        "sandbox",
        "simulated"
      ],
      "x-classification": "public"
    },
    "source_refs": {
      "type": "array",
      "maxItems": 100,
      "x-classification": "restricted",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "kind",
          "id"
        ],
        "properties": {
          "kind": {
            "type": "string",
            "enum": [
              "artifact",
              "evidence",
              "source_observation",
              "provider_request",
              "manifest"
            ],
            "x-classification": "internal"
          },
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_.:-]{1,256}(?![\\s\\S])",
            "x-classification": "restricted"
          },
          "content_hash": {
            "$ref": "https://schemas.jevelopers.org/CommonEnvelope/1.0.0#/$defs/Sha256",
            "x-classification": "restricted",
            "type": "string",
            "minLength": 71,
            "maxLength": 71
          }
        }
      }
    },
    "source_observation_id": {
      "$ref": "https://schemas.jevelopers.org/ErrorEnvelope/1.0.0#/$defs/SourceObservationId",
      "x-classification": "restricted"
    },
    "provider": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_.:-]{1,128}(?![\\s\\S])",
      "x-classification": "restricted"
    },
    "model": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_.:-]{1,128}(?![\\s\\S])",
      "x-classification": "restricted"
    },
    "source": {
      "type": "string",
      "enum": [
        "provider_response",
        "provider_usage_api",
        "trace",
        "billing_export",
        "other"
      ],
      "x-classification": "restricted"
    },
    "completeness": {
      "type": "string",
      "enum": [
        "unknown",
        "incomplete",
        "complete"
      ],
      "x-classification": "restricted"
    },
    "usage_units": {
      "anyOf": [
        {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "name": {
                "type": "string",
                "pattern": "^[A-Za-z0-9_.:-]{1,128}(?![\\s\\S])",
                "x-classification": "restricted"
              },
              "quantity": {
                "$ref": "https://schemas.jevelopers.org/CommonEnvelope/1.0.0#/$defs/ExactDecimal",
                "x-classification": "restricted",
                "type": "string",
                "maxLength": 128,
                "pattern": "^(0|[1-9][0-9]*)(\\.[0-9]+)?(?![\\s\\S])"
              },
              "scale": {
                "type": "integer",
                "minimum": 0,
                "maximum": 18,
                "x-classification": "restricted"
              },
              "relation": {
                "type": "string",
                "enum": [
                  "standalone",
                  "included_subset",
                  "unknown_relation"
                ],
                "x-classification": "restricted"
              },
              "included_in": {
                "type": "string",
                "pattern": "^[A-Za-z0-9_.:-]{1,128}(?![\\s\\S])",
                "x-classification": "restricted"
              }
            },
            "required": [
              "name",
              "quantity",
              "scale",
              "relation"
            ]
          },
          "maxItems": 100
        },
        {
          "type": "null"
        }
      ],
      "x-classification": "restricted"
    },
    "missing_fields": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[A-Za-z0-9_.:-]{1,128}(?![\\s\\S])"
      },
      "maxItems": 100,
      "x-classification": "restricted"
    },
    "valuation": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "basis": {
              "const": "unknown",
              "x-classification": "restricted"
            },
            "money": {
              "type": "null",
              "x-classification": "restricted"
            },
            "rate_card_ref": {
              "anyOf": [
                {
                  "$ref": "https://schemas.jevelopers.org/ErrorEnvelope/1.0.0#/$defs/VersionedReference"
                },
                {
                  "type": "null"
                }
              ],
              "x-classification": "restricted"
            }
          },
          "required": [
            "basis",
            "money",
            "rate_card_ref"
          ]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "basis": {
              "type": "string",
              "enum": [
                "estimated",
                "provider_confirmed"
              ],
              "x-classification": "restricted"
            },
            "money": {
              "$ref": "https://schemas.jevelopers.org/ErrorEnvelope/1.0.0#/$defs/Money",
              "x-classification": "restricted"
            },
            "rate_card_ref": {
              "$ref": "https://schemas.jevelopers.org/ErrorEnvelope/1.0.0#/$defs/VersionedReference",
              "x-classification": "restricted"
            }
          },
          "required": [
            "basis",
            "money",
            "rate_card_ref"
          ]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "basis": {
              "const": "provider_reported_unsettled",
              "x-classification": "restricted"
            },
            "money": {
              "allOf": [
                {
                  "$ref": "https://schemas.jevelopers.org/ErrorEnvelope/1.0.0#/$defs/Money",
                  "x-classification": "restricted"
                },
                {
                  "type": "object",
                  "properties": {
                    "currency": {
                      "const": "USD",
                      "x-classification": "restricted"
                    }
                  },
                  "required": [
                    "currency"
                  ]
                }
              ],
              "x-classification": "restricted"
            },
            "rate_card_ref": {
              "type": "null",
              "x-classification": "restricted"
            },
            "provider_evidence_ref": {
              "allOf": [
                {
                  "$ref": "https://schemas.jevelopers.org/ErrorEnvelope/1.0.0#/$defs/VersionedReference",
                  "x-classification": "restricted"
                },
                {
                  "type": "object",
                  "properties": {
                    "contract": {
                      "const": "ProviderReportedCostEvidence",
                      "x-classification": "public"
                    },
                    "schema_version": {
                      "const": "1.0.0",
                      "x-classification": "public"
                    }
                  },
                  "required": [
                    "contract",
                    "schema_version"
                  ]
                }
              ],
              "x-classification": "restricted"
            }
          },
          "required": [
            "basis",
            "money",
            "rate_card_ref",
            "provider_evidence_ref"
          ]
        }
      ],
      "x-classification": "restricted"
    },
    "outcome": {
      "type": "string",
      "enum": [
        "succeeded",
        "failed",
        "partial",
        "unknown",
        "timeout",
        "cancelled"
      ],
      "x-classification": "restricted"
    },
    "retry_mapping_ref": {
      "$ref": "https://schemas.jevelopers.org/ErrorEnvelope/1.0.0#/$defs/VersionedReference",
      "x-classification": "restricted"
    },
    "supersedes_observation_id": {
      "anyOf": [
        {
          "$ref": "https://schemas.jevelopers.org/ErrorEnvelope/1.0.0#/$defs/SourceObservationId"
        },
        {
          "type": "null"
        }
      ],
      "x-classification": "restricted"
    },
    "reconciliation_ref": {
      "anyOf": [
        {
          "$ref": "https://schemas.jevelopers.org/ErrorEnvelope/1.0.0#/$defs/VersionedReference"
        },
        {
          "type": "null"
        }
      ],
      "x-classification": "restricted"
    }
  },
  "required": [
    "contract",
    "schema_version",
    "policy_version",
    "event_id",
    "tenant_id",
    "project_id",
    "correlation_id",
    "producer",
    "occurred_at",
    "observed_at",
    "ingested_at",
    "environment",
    "billing_mode",
    "source_refs",
    "usage_event_id",
    "source_observation_id",
    "logical_operation_id",
    "provider_attempt_id",
    "billable_attempt_id",
    "transport_attempt_id",
    "provider_request_id",
    "provider",
    "model",
    "source",
    "completeness",
    "usage_units",
    "missing_fields",
    "valuation",
    "outcome",
    "retry_mapping_ref",
    "supersedes_observation_id",
    "reconciliation_ref"
  ],
  "allOf": [
    {
      "if": {
      "properties": {
        "valuation": {
          "type": "object",
              "properties": {
              "basis": {
                "const": "provider_reported_unsettled",
                "x-classification": "restricted"
              }
            },
            "required": [
              "basis"
            ],
            "x-classification": "restricted"
          }
        },
        "required": [
          "valuation"
        ]
      },
      "then": {
        "properties": {
          "reconciliation_ref": {
            "type": "null",
            "x-classification": "restricted"
          }
        }
      }
    }
  ]
}
