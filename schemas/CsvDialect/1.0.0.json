{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.jevelopers.org/CsvDialect/1.0.0",
  "title": "CsvDialect",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "contract": {
      "const": "CsvDialect",
      "x-classification": "public"
    },
    "schema_version": {
      "const": "1.0.0",
      "x-classification": "public"
    },
    "policy_version": {
      "const": "1.0.0",
      "x-classification": "public"
    },
    "tenant_id": {
      "$ref": "https://schemas.jevelopers.org/CommonEnvelope/1.0.0#/$defs/TenantId",
      "x-classification": "restricted"
    },
    "project_id": {
      "$ref": "https://schemas.jevelopers.org/CommonEnvelope/1.0.0#/$defs/ProjectId",
      "x-classification": "restricted"
    },
    "id": {
      "type": "string",
      "format": "uuid",
      "x-classification": "restricted",
      "minLength": 36,
      "maxLength": 36
    },
    "revision": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991,
      "x-classification": "restricted"
    },
    "content_hash": {
      "$ref": "https://schemas.jevelopers.org/CommonEnvelope/1.0.0#/$defs/Sha256",
      "x-classification": "restricted",
      "type": "string",
      "minLength": 71,
      "maxLength": 71
    },
    "encoding": {
      "const": "utf-8",
      "x-classification": "public"
    },
    "bom": {
      "type": "string",
      "enum": [
        "forbidden",
        "optional",
        "required"
      ],
      "x-classification": "restricted"
    },
    "delimiter": {
      "type": "string",
      "enum": [
        ",",
        ";",
        "\t"
      ],
      "x-classification": "restricted"
    },
    "quote": {
      "const": "\"",
      "x-classification": "public"
    },
    "newline": {
      "type": "string",
      "enum": [
        "lf",
        "crlf"
      ],
      "x-classification": "restricted"
    },
    "header": {
      "const": "required",
      "x-classification": "public"
    },
    "maximum_record_bytes": {
      "type": "integer",
      "minimum": 1,
      "maximum": 131072,
      "x-classification": "restricted"
    }
  },
  "required": [
    "contract",
    "schema_version",
    "policy_version",
    "tenant_id",
    "project_id",
    "id",
    "revision",
    "content_hash",
    "encoding",
    "bom",
    "delimiter",
    "quote",
    "newline",
    "header",
    "maximum_record_bytes"
  ],
  "x-classification": "restricted"
}
