{
  "name": "@jevelopers/shared-contracts",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "engines": { "node": ">=22.23.3 <23" },
  "files": ["generated", "tooling/runtime.mjs", "tooling/operations.mjs", "schemas", "fixtures", "compatibility", "docs", "examples", "README.md"],
  "exports": {
    ".": { "types": "./generated/index.d.ts", "import": "./generated/index.mjs" },
    "./operations": { "types": "./generated/operations.d.ts", "import": "./tooling/operations.mjs" },
    "./schemas/*": "./schemas/*",
    "./fixtures/*": "./fixtures/*",
    "./compatibility/*": "./compatibility/*"
  },
  "scripts": {
    "generate": "node scripts/generate.mjs",
    "contracts:check": "node scripts/contracts.mjs check",
    "contracts:fixtures": "node scripts/contracts.mjs fixtures",
    "contracts:compat": "node scripts/contracts.mjs compat",
    "contracts:inventory": "node scripts/contracts.mjs inventory",
    "contracts:consumers": "node scripts/contracts.mjs consumers",
    "docs:check": "node scripts/contracts.mjs docs",
    "build": "npm run generate && npm run typecheck",
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/*.test.mjs",
    "test:installed": "node scripts/installed-consumer.mjs"
  },
  "devDependencies": {
    "esbuild": "0.25.12",
    "ajv": "8.17.1",
    "json-schema-to-typescript": "15.0.4",
    "typescript": "5.9.3"
  }
}
