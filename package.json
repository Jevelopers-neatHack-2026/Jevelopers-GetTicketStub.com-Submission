{
  "name": "@jevelopers/fulfillment-connectors",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Typed worker runtime foundation for fulfillment provider adapters",
  "engines": {
    "node": "24.15.0"
  },
  "packageManager": "npm@11.12.1",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "docs/runtime.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "npm run build && node scripts/run-contract-tests.mjs",
    "verify:contract": "./scripts/verify-fulfillment --suite contract --mode simulated --evidence-dir evidence/FC-01"
  },
  "devDependencies": {
    "typescript": "6.0.3"
  }
}
