{
  "name": "@jevelopers/shared-contracts",
  "version": "0.9.1",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.23.3 <23 || >=24.21.0 <25"
  },
  "files": [
    "generated",
    "tooling/runtime.mjs",
    "tooling/operations.mjs",
    "tooling/research-creative.mjs",
    "tooling/commerce-evidence.mjs",
    "tooling/fixture-harness.mjs",
    "tooling/finance-v2.mjs",
    "tooling/capability.mjs",
    "tooling/capability-data.mjs",
    "tooling/capability-identity.mjs",
    "tooling/capability-consistency.mjs",
    "tooling/capability-adapter.mjs",
    "tooling/historical-finance-fixtures.mjs",
    "tooling/production-operations.mjs",
    "tooling/production-errors.mjs",
    "tooling/production-values.mjs",
    "tooling/production-rows.mjs",
    "tooling/production-csv.mjs",
    "tooling/production-bundle.mjs",
    "tooling/production-zip.mjs",
    "tooling/production-preflight.mjs",
    "tooling/production-error-adapter.mjs",
    "tooling/production-fixture-check.mjs",
    "schemas",
    "fixtures",
    "compatibility",
    "docs",
    "examples",
    "README.md",
    "CHANGELOG.md"
  ],
  "exports": {
    "./production-operations": {
      "types": "./generated/production-operations.d.ts",
      "import": "./tooling/production-operations.mjs"
    },
    "./capability": {
      "types": "./generated/capability.d.ts",
      "import": "./tooling/capability.mjs"
    },
    ".": {
      "types": "./generated/index.d.ts",
      "import": "./generated/index.mjs"
    },
    "./operations": {
      "types": "./generated/operations.d.ts",
      "import": "./tooling/operations.mjs"
    },
    "./research-creative": {
      "types": "./generated/research-creative.d.ts",
      "import": "./tooling/research-creative.mjs"
    },
    "./commerce-evidence": {
      "types": "./generated/commerce-evidence.d.ts",
      "import": "./tooling/commerce-evidence.mjs"
    },
    "./fixture-harness": {
      "types": "./generated/fixture-harness.d.ts",
      "import": "./tooling/fixture-harness.mjs"
    },
    "./schemas/*": "./schemas/*",
    "./fixtures/*": "./fixtures/*",
    "./compatibility/*": "./compatibility/*",
    "./finance-v2": {
      "types": "./generated/finance-v2.d.ts",
      "import": "./tooling/finance-v2.mjs"
    }
  },
  "scripts": {
    "generate": "node scripts/generate.mjs",
    "contracts:check": "node scripts/contracts.mjs check",
    "contracts:fixtures": "node scripts/contracts.mjs fixtures",
    "contracts:compat": "node scripts/contracts.mjs compat",
    "contracts:inventory": "node scripts/contracts.mjs inventory",
    "contracts:consumers": "node scripts/contracts.mjs consumers",
    "contracts:coverage": "node scripts/coverage.mjs",
    "docs:check": "node scripts/contracts.mjs docs",
    "build": "npm run generate && npm run typecheck",
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/*.test.mjs",
    "test:installed": "node scripts/installed-consumer.mjs"
  },
  "devDependencies": {
    "esbuild": "0.25.12",
    "ajv": "8.17.1",
    "json-schema-to-typescript": "15.0.4",
    "typescript": "5.9.3"
  }
}
