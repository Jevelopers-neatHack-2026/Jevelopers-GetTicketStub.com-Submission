{
  "name": "@jevelopers/fulfillment-connectors",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Typed worker runtime foundation for fulfillment provider adapters",
  "engines": {
    "node": "24.15.0"
  },
  "packageManager": "npm@11.12.1",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "docs/runtime.md",
    "docs/provider-matrix.md",
    "docs/catalog.md",
    "docs/simulator.md",
    "docs/quotes.md",
    "docs/comparison.md",
    "docs/attempt-store.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "npm run build && node scripts/run-contract-tests.mjs && node scripts/run-provider-matrix-tests.mjs && node scripts/run-metering-tests.mjs && node scripts/run-security-tests.mjs && node scripts/run-catalog-tests.mjs && node scripts/run-mock-tests.mjs && node scripts/run-quote-tests.mjs && node scripts/run-attempt-store-tests.mjs && node scripts/run-comparison-tests.mjs",
    "test:catalog": "node scripts/run-catalog-tests.mjs",
    "test:quote": "npm run build && node scripts/run-quote-tests.mjs",
    "test:attempt-store": "npm run build && node scripts/run-attempt-store-tests.mjs",
    "test:comparison": "npm run build && node scripts/run-comparison-tests.mjs",
    "verify:contract": "./scripts/verify-fulfillment --suite contract --mode simulated --evidence-dir evidence/FC-01",
    "verify:provider-matrix": "./scripts/verify-fulfillment --suite provider-matrix --mode simulated --evidence-dir evidence/FC-02",
    "verify:security": "./scripts/verify-fulfillment --suite security --mode simulated --evidence-dir evidence/FC-11",
    "verify:metering": "./scripts/verify-fulfillment --suite metering --mode simulated --evidence-dir evidence/FC-10",
    "verify:catalog": "./scripts/verify-fulfillment --suite catalog --mode simulated --evidence-dir evidence/FC-03",
    "verify:mock": "./scripts/verify-fulfillment --suite mock --mode simulated --evidence-dir evidence/FC-02-MOCK",
    "verify:quote": "./scripts/verify-fulfillment --suite quote --mode simulated --evidence-dir evidence/FC-04",
    "verify:attempt-store": "./scripts/verify-fulfillment --suite attempt-store --mode simulated --evidence-dir evidence/FC-06-ATTEMPT-STORE",
    "verify:comparison": "./scripts/verify-fulfillment --suite comparison --mode simulated --evidence-dir evidence/FC-09-COMPARISON"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "typescript": "6.0.3"
  }
}
