{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.jevelopers.org/DecisionReceipt/1.0.0",
  "title": "DecisionReceipt",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "contract": {
      "const": "DecisionReceipt",
      "x-classification": "public"
    },
    "schema_version": {
      "const": "1.0.0",
      "x-classification": "public"
    },
    "policy_version": {
      "const": "1.0.0",
      "x-classification": "public"
    },
    "event_id": {
      "$ref": "https://schemas.jevelopers.org/CommonEnvelope/1.0.0#/$defs/EventId",
      "x-classification": "internal"
    },
    "tenant_id": {
      "$ref": "https://schemas.jevelopers.org/CommonEnvelope/1.0.0#/$defs/TenantId",
      "x-classification": "restricted"
    },
    "project_id": {
      "$ref": "https://schemas.jevelopers.org/CommonEnvelope/1.0.0#/$defs/ProjectId",
      "x-classification": "restricted"
    },
    "workflow_id": {
      "$ref": "https://schemas.jevelopers.org/CommonEnvelope/1.0.0#/$defs/WorkflowId",
      "x-classification": "internal"
    },
    "run_id": {
      "$ref": "https://schemas.jevelopers.org/CommonEnvelope/1.0.0#/$defs/RunId",
      "x-classification": "internal"
    },
    "job_id": {
      "$ref": "https://schemas.jevelopers.org/CommonEnvelope/1.0.0#/$defs/JobId",
      "x-classification": "internal"
    },
    "artifact_id": {
      "$ref": "https://schemas.jevelopers.org/CommonEnvelope/1.0.0#/$defs/ArtifactId",
      "x-classification": "restricted"
    },
    "design_id": {
      "$ref": "https://schemas.jevelopers.org/CommonEnvelope/1.0.0#/$defs/DesignId",
      "x-classification": "restricted"
    },
    "design_version_id": {
      "$ref": "https://schemas.jevelopers.org/CommonEnvelope/1.0.0#/$defs/DesignVersionId",
      "x-classification": "restricted"
    },
    "order_id": {
      "$ref": "https://schemas.jevelopers.org/CommonEnvelope/1.0.0#/$defs/OrderId",
      "x-classification": "restricted"
    },
    "trace_id": {
      "$ref": "https://schemas.jevelopers.org/CommonEnvelope/1.0.0#/$defs/TraceId",
      "x-classification": "internal"
    },
    "correlation_id": {
      "$ref": "https://schemas.jevelopers.org/CommonEnvelope/1.0.0#/$defs/CorrelationId",
      "x-classification": "internal"
    },
    "evidence_id": {
      "$ref": "https://schemas.jevelopers.org/CommonEnvelope/1.0.0#/$defs/EvidenceId",
      "x-classification": "internal"
    },
    "usage_event_id": {
      "$ref": "https://schemas.jevelopers.org/CommonEnvelope/1.0.0#/$defs/UsageEventId",
      "x-classification": "internal"
    },
    "logical_operation_id": {
      "$ref": "https://schemas.jevelopers.org/CommonEnvelope/1.0.0#/$defs/LogicalOperationId",
      "x-classification": "restricted"
    },
    "provider_attempt_id": {
      "$ref": "https://schemas.jevelopers.org/CommonEnvelope/1.0.0#/$defs/ProviderAttemptId",
      "x-classification": "internal"
    },
    "billable_attempt_id": {
      "$ref": "https://schemas.jevelopers.org/CommonEnvelope/1.0.0#/$defs/BillableAttemptId",
      "x-classification": "restricted"
    },
    "transport_attempt_id": {
      "$ref": "https://schemas.jevelopers.org/CommonEnvelope/1.0.0#/$defs/TransportAttemptId",
      "x-classification": "internal"
    },
    "provider_request_id": {
      "$ref": "https://schemas.jevelopers.org/CommonEnvelope/1.0.0#/$defs/ProviderRequestId",
      "x-classification": "restricted"
    },
    "producer": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "module",
        "source_revision",
        "build_revision"
      ],
      "x-classification": "internal",
      "properties": {
        "module": {
          "type": "string",
          "enum": [
            "getticketstub.com",
            "agent-harness",
            "event-intelligence",
            "creative-engine",
            "print-production",
            "fulfillment-connectors",
            "cost-intelligence",
            "team-dashboard",
            "integration-evals",
            "shared-contracts"
          ],
          "x-classification": "public"
        },
        "source_revision": {
          "$ref": "https://schemas.jevelopers.org/CommonEnvelope/1.0.0#/$defs/SourceRevision",
          "x-classification": "public",
          "type": "string",
          "minLength": 40,
          "maxLength": 40
        },
        "build_revision": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_.-]{1,128}(?![\\s\\S])",
          "x-classification": "internal"
        }
      }
    },
    "occurred_at": {
      "$ref": "https://schemas.jevelopers.org/CommonEnvelope/1.0.0#/$defs/UtcTime",
      "x-classification": "internal",
      "type": "string",
      "pattern": "Z(?![\\s\\S])"
    },
    "observed_at": {
      "$ref": "https://schemas.jevelopers.org/CommonEnvelope/1.0.0#/$defs/UtcTime",
      "x-classification": "internal",
      "type": "string",
      "pattern": "Z(?![\\s\\S])"
    },
    "ingested_at": {
      "$ref": "https://schemas.jevelopers.org/CommonEnvelope/1.0.0#/$defs/UtcTime",
      "x-classification": "internal",
      "type": "string",
      "pattern": "Z(?![\\s\\S])"
    },
    "environment": {
      "type": "string",
      "enum": [
        "development",
        "test",
        "production"
      ],
      "x-classification": "public"
    },
    "billing_mode": {
      "type": "string",
      "enum": [
        "live",
        "sandbox",
        "simulated"
      ],
      "x-classification": "public"
    },
    "source_refs": {
      "type": "array",
      "maxItems": 100,
      "x-classification": "restricted",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "kind",
          "id"
        ],
        "properties": {
          "kind": {
            "type": "string",
            "enum": [
              "artifact",
              "evidence",
              "source_observation",
              "provider_request",
              "manifest"
            ],
            "x-classification": "internal"
          },
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_.:-]{1,256}(?![\\s\\S])",
            "x-classification": "restricted"
          },
          "content_hash": {
            "$ref": "https://schemas.jevelopers.org/CommonEnvelope/1.0.0#/$defs/Sha256",
            "x-classification": "restricted",
            "type": "string",
            "minLength": 71,
            "maxLength": 71
          }
        }
      }
    },
    "receipt_id": {
      "type": "string",
      "format": "uuid",
      "tsType": "Brand<string, 'DecisionReceiptId'>",
      "x-classification": "restricted",
      "minLength": 36,
      "maxLength": 36
    },
    "request_id": {
      "$ref": "https://schemas.jevelopers.org/ErrorEnvelope/1.0.0#/$defs/RequestId",
      "x-classification": "restricted"
    },
    "batch_id": {
      "$ref": "https://schemas.jevelopers.org/ErrorEnvelope/1.0.0#/$defs/BatchId",
      "x-classification": "restricted"
    },
    "request_hash": {
      "$ref": "https://schemas.jevelopers.org/CommonEnvelope/1.0.0#/$defs/Sha256",
      "x-classification": "restricted",
      "type": "string",
      "minLength": 71,
      "maxLength": 71
    },
    "result_hash": {
      "$ref": "https://schemas.jevelopers.org/CommonEnvelope/1.0.0#/$defs/Sha256",
      "x-classification": "restricted",
      "type": "string",
      "minLength": 71,
      "maxLength": 71
    },
    "question_hashes": {
      "type": "object",
      "minProperties": 1,
      "maxProperties": 24,
      "propertyNames": {
        "pattern": "^[A-Za-z0-9_-]{1,64}(?![\\s\\S])"
      },
      "additionalProperties": {
        "$ref": "https://schemas.jevelopers.org/CommonEnvelope/1.0.0#/$defs/Sha256",
        "x-classification": "restricted",
        "type": "string",
        "minLength": 71,
        "maxLength": 71
      },
      "x-classification": "restricted"
    },
    "answer_hashes": {
      "type": "object",
      "minProperties": 1,
      "maxProperties": 24,
      "propertyNames": {
        "pattern": "^[A-Za-z0-9_-]{1,64}(?![\\s\\S])"
      },
      "additionalProperties": {
        "$ref": "https://schemas.jevelopers.org/CommonEnvelope/1.0.0#/$defs/Sha256",
        "x-classification": "restricted",
        "type": "string",
        "minLength": 71,
        "maxLength": 71
      },
      "x-classification": "restricted"
    },
    "model_ref": {
      "$ref": "https://schemas.jevelopers.org/ErrorEnvelope/1.0.0#/$defs/VersionedReference",
      "x-classification": "restricted"
    },
    "policy_ref": {
      "$ref": "https://schemas.jevelopers.org/ErrorEnvelope/1.0.0#/$defs/VersionedReference",
      "x-classification": "restricted"
    },
    "state_ref": {
      "$ref": "https://schemas.jevelopers.org/ErrorEnvelope/1.0.0#/$defs/VersionedReference",
      "x-classification": "restricted"
    },
    "normalized_result": {
      "$ref": "https://schemas.jevelopers.org/DecisionPortResult/1.0.0",
      "x-classification": "restricted"
    },
    "decided_at": {
      "$ref": "https://schemas.jevelopers.org/CommonEnvelope/1.0.0#/$defs/UtcTime",
      "x-classification": "restricted",
      "type": "string",
      "pattern": "Z(?![\\s\\S])"
    },
    "usage_ref": {
      "anyOf": [
        {
          "$ref": "https://schemas.jevelopers.org/ErrorEnvelope/1.0.0#/$defs/VersionedReference"
        },
        {
          "type": "null"
        }
      ],
      "x-classification": "restricted"
    },
    "review_reason": {
      "type": "string",
      "enum": [
        "none",
        "low_confidence",
        "uncertain",
        "partial",
        "unavailable",
        "timeout",
        "cancelled",
        "malformed",
        "abstain"
      ],
      "x-classification": "restricted"
    }
  },
  "required": [
    "contract",
    "schema_version",
    "policy_version",
    "event_id",
    "tenant_id",
    "project_id",
    "correlation_id",
    "producer",
    "occurred_at",
    "observed_at",
    "ingested_at",
    "environment",
    "billing_mode",
    "source_refs",
    "receipt_id",
    "request_id",
    "batch_id",
    "logical_operation_id",
    "billable_attempt_id",
    "request_hash",
    "result_hash",
    "question_hashes",
    "answer_hashes",
    "model_ref",
    "policy_ref",
    "state_ref",
    "normalized_result",
    "decided_at",
    "usage_ref",
    "review_reason"
  ]
}
