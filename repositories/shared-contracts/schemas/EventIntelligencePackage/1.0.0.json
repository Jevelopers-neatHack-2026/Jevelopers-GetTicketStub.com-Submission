{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.jevelopers.org/EventIntelligencePackage/1.0.0",
  "title": "EventIntelligencePackage",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "contract": {
      "const": "EventIntelligencePackage",
      "x-classification": "public"
    },
    "schema_version": {
      "const": "1.0.0",
      "x-classification": "public"
    },
    "policy_version": {
      "const": "1.0.0",
      "x-classification": "public"
    },
    "event_id": {
      "$ref": "https://schemas.jevelopers.org/CommonEnvelope/1.0.0#/$defs/EventId",
      "x-classification": "internal"
    },
    "tenant_id": {
      "$ref": "https://schemas.jevelopers.org/CommonEnvelope/1.0.0#/$defs/TenantId",
      "x-classification": "restricted"
    },
    "project_id": {
      "$ref": "https://schemas.jevelopers.org/CommonEnvelope/1.0.0#/$defs/ProjectId",
      "x-classification": "restricted"
    },
    "workflow_id": {
      "$ref": "https://schemas.jevelopers.org/CommonEnvelope/1.0.0#/$defs/WorkflowId",
      "x-classification": "internal"
    },
    "run_id": {
      "$ref": "https://schemas.jevelopers.org/CommonEnvelope/1.0.0#/$defs/RunId",
      "x-classification": "internal"
    },
    "job_id": {
      "$ref": "https://schemas.jevelopers.org/CommonEnvelope/1.0.0#/$defs/JobId",
      "x-classification": "internal"
    },
    "artifact_id": {
      "$ref": "https://schemas.jevelopers.org/CommonEnvelope/1.0.0#/$defs/ArtifactId",
      "x-classification": "restricted"
    },
    "design_id": {
      "$ref": "https://schemas.jevelopers.org/CommonEnvelope/1.0.0#/$defs/DesignId",
      "x-classification": "restricted"
    },
    "design_version_id": {
      "$ref": "https://schemas.jevelopers.org/CommonEnvelope/1.0.0#/$defs/DesignVersionId",
      "x-classification": "restricted"
    },
    "order_id": {
      "$ref": "https://schemas.jevelopers.org/CommonEnvelope/1.0.0#/$defs/OrderId",
      "x-classification": "restricted"
    },
    "trace_id": {
      "$ref": "https://schemas.jevelopers.org/CommonEnvelope/1.0.0#/$defs/TraceId",
      "x-classification": "internal"
    },
    "correlation_id": {
      "$ref": "https://schemas.jevelopers.org/CommonEnvelope/1.0.0#/$defs/CorrelationId",
      "x-classification": "internal"
    },
    "evidence_id": {
      "$ref": "https://schemas.jevelopers.org/CommonEnvelope/1.0.0#/$defs/EvidenceId",
      "x-classification": "internal"
    },
    "usage_event_id": {
      "$ref": "https://schemas.jevelopers.org/CommonEnvelope/1.0.0#/$defs/UsageEventId",
      "x-classification": "internal"
    },
    "logical_operation_id": {
      "$ref": "https://schemas.jevelopers.org/CommonEnvelope/1.0.0#/$defs/LogicalOperationId",
      "x-classification": "internal"
    },
    "provider_attempt_id": {
      "$ref": "https://schemas.jevelopers.org/CommonEnvelope/1.0.0#/$defs/ProviderAttemptId",
      "x-classification": "internal"
    },
    "billable_attempt_id": {
      "$ref": "https://schemas.jevelopers.org/CommonEnvelope/1.0.0#/$defs/BillableAttemptId",
      "x-classification": "internal"
    },
    "transport_attempt_id": {
      "$ref": "https://schemas.jevelopers.org/CommonEnvelope/1.0.0#/$defs/TransportAttemptId",
      "x-classification": "internal"
    },
    "provider_request_id": {
      "$ref": "https://schemas.jevelopers.org/CommonEnvelope/1.0.0#/$defs/ProviderRequestId",
      "x-classification": "restricted"
    },
    "producer": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "module",
        "source_revision",
        "build_revision"
      ],
      "x-classification": "internal",
      "properties": {
        "module": {
          "type": "string",
          "enum": [
            "getticketstub.com",
            "agent-harness",
            "event-intelligence",
            "creative-engine",
            "print-production",
            "fulfillment-connectors",
            "cost-intelligence",
            "team-dashboard",
            "integration-evals",
            "shared-contracts"
          ],
          "x-classification": "public"
        },
        "source_revision": {
          "$ref": "https://schemas.jevelopers.org/CommonEnvelope/1.0.0#/$defs/SourceRevision",
          "x-classification": "public"
        },
        "build_revision": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_.-]{1,128}$",
          "x-classification": "internal"
        }
      }
    },
    "occurred_at": {
      "$ref": "https://schemas.jevelopers.org/CommonEnvelope/1.0.0#/$defs/UtcTime",
      "x-classification": "internal"
    },
    "observed_at": {
      "$ref": "https://schemas.jevelopers.org/CommonEnvelope/1.0.0#/$defs/UtcTime",
      "x-classification": "internal"
    },
    "ingested_at": {
      "$ref": "https://schemas.jevelopers.org/CommonEnvelope/1.0.0#/$defs/UtcTime",
      "x-classification": "internal"
    },
    "environment": {
      "type": "string",
      "enum": [
        "development",
        "test",
        "production"
      ],
      "x-classification": "public"
    },
    "billing_mode": {
      "type": "string",
      "enum": [
        "live",
        "sandbox",
        "simulated"
      ],
      "x-classification": "public"
    },
    "source_refs": {
      "type": "array",
      "maxItems": 100,
      "x-classification": "restricted",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "kind",
          "id"
        ],
        "properties": {
          "kind": {
            "type": "string",
            "enum": [
              "artifact",
              "evidence",
              "source_observation",
              "provider_request",
              "manifest"
            ],
            "x-classification": "internal"
          },
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_.:-]{1,256}$",
            "x-classification": "restricted"
          },
          "content_hash": {
            "$ref": "https://schemas.jevelopers.org/CommonEnvelope/1.0.0#/$defs/Sha256",
            "x-classification": "restricted"
          }
        }
      }
    },
    "package_id": {
      "$ref": "https://schemas.jevelopers.org/EventIntelligencePackage/1.0.0#/$defs/PackageId",
      "x-classification": "restricted"
    },
    "package_version": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991,
      "x-classification": "restricted"
    },
    "package_hash": {
      "$ref": "https://schemas.jevelopers.org/CommonEnvelope/1.0.0#/$defs/Sha256",
      "x-classification": "restricted"
    },
    "parent_ref": {
      "anyOf": [
        {
          "$ref": "https://schemas.jevelopers.org/ErrorEnvelope/1.0.0#/$defs/VersionedReference"
        },
        {
          "type": "null"
        }
      ],
      "x-classification": "restricted"
    },
    "request_ref": {
      "$ref": "https://schemas.jevelopers.org/ErrorEnvelope/1.0.0#/$defs/VersionedReference",
      "x-classification": "restricted"
    },
    "request_receipt_ref": {
      "$ref": "https://schemas.jevelopers.org/ErrorEnvelope/1.0.0#/$defs/VersionedReference",
      "x-classification": "restricted"
    },
    "answer_receipt_refs": {
      "type": "array",
      "items": {
        "$ref": "https://schemas.jevelopers.org/ErrorEnvelope/1.0.0#/$defs/VersionedReference"
      },
      "maxItems": 64,
      "minItems": 1,
      "x-classification": "restricted"
    },
    "batch_receipt_ref": {
      "$ref": "https://schemas.jevelopers.org/ErrorEnvelope/1.0.0#/$defs/VersionedReference",
      "x-classification": "restricted"
    },
    "sources": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "source_id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]{1,64}$",
            "x-classification": "restricted"
          },
          "url": {
            "type": "string",
            "pattern": "^https?://[^\\s]+$",
            "maxLength": 2048,
            "x-classification": "restricted"
          },
          "retrieved_at": {
            "$ref": "https://schemas.jevelopers.org/CommonEnvelope/1.0.0#/$defs/UtcTime",
            "x-classification": "restricted"
          },
          "content_hash": {
            "$ref": "https://schemas.jevelopers.org/CommonEnvelope/1.0.0#/$defs/Sha256",
            "x-classification": "restricted"
          },
          "retention_ref": {
            "$ref": "https://schemas.jevelopers.org/ErrorEnvelope/1.0.0#/$defs/VersionedReference",
            "x-classification": "restricted"
          },
          "access_ref": {
            "$ref": "https://schemas.jevelopers.org/ErrorEnvelope/1.0.0#/$defs/VersionedReference",
            "x-classification": "restricted"
          }
        },
        "required": [
          "source_id",
          "url",
          "retrieved_at",
          "content_hash",
          "retention_ref",
          "access_ref"
        ]
      },
      "maxItems": 100,
      "minItems": 1,
      "x-classification": "restricted"
    },
    "facts": {
      "type": "array",
      "items": {
        "$ref": "https://schemas.jevelopers.org/EventIntelligencePackage/1.0.0#/$defs/ResearchFact"
      },
      "maxItems": 64,
      "minItems": 1,
      "x-classification": "restricted"
    },
    "asset_candidates": {
      "type": "array",
      "items": {
        "$ref": "https://schemas.jevelopers.org/EventIntelligencePackage/1.0.0#/$defs/AssetCandidate"
      },
      "maxItems": 100,
      "minItems": 0,
      "x-classification": "restricted"
    },
    "approved_assets": {
      "type": "array",
      "items": {
        "$ref": "https://schemas.jevelopers.org/EventIntelligencePackage/1.0.0#/$defs/ApprovedAsset"
      },
      "maxItems": 100,
      "minItems": 0,
      "x-classification": "restricted"
    },
    "readiness": {
      "type": "string",
      "enum": [
        "ready",
        "review"
      ],
      "x-classification": "restricted"
    },
    "expires_at": {
      "$ref": "https://schemas.jevelopers.org/CommonEnvelope/1.0.0#/$defs/UtcTime",
      "x-classification": "restricted"
    },
    "policy_ref": {
      "$ref": "https://schemas.jevelopers.org/ErrorEnvelope/1.0.0#/$defs/VersionedReference",
      "x-classification": "restricted"
    },
    "decision_refs": {
      "type": "array",
      "items": {
        "$ref": "https://schemas.jevelopers.org/ErrorEnvelope/1.0.0#/$defs/VersionedReference"
      },
      "maxItems": 100,
      "minItems": 0,
      "x-classification": "restricted"
    },
    "usage_refs": {
      "type": "array",
      "items": {
        "$ref": "https://schemas.jevelopers.org/ErrorEnvelope/1.0.0#/$defs/VersionedReference"
      },
      "maxItems": 100,
      "minItems": 0,
      "x-classification": "restricted"
    }
  },
  "required": [
    "contract",
    "schema_version",
    "policy_version",
    "event_id",
    "tenant_id",
    "project_id",
    "correlation_id",
    "producer",
    "occurred_at",
    "observed_at",
    "ingested_at",
    "environment",
    "billing_mode",
    "source_refs",
    "package_id",
    "package_version",
    "package_hash",
    "parent_ref",
    "request_ref",
    "request_receipt_ref",
    "answer_receipt_refs",
    "batch_receipt_ref",
    "sources",
    "facts",
    "asset_candidates",
    "approved_assets",
    "readiness",
    "expires_at",
    "policy_ref",
    "decision_refs",
    "usage_refs"
  ],
  "$defs": {
    "PackageId": {
      "type": "string",
      "format": "uuid",
      "minLength": 36,
      "maxLength": 36,
      "tsType": "Brand<string, 'PackageId'>"
    },
    "FactId": {
      "type": "string",
      "format": "uuid",
      "minLength": 36,
      "maxLength": 36,
      "tsType": "Brand<string, 'FactId'>"
    },
    "AssetId": {
      "type": "string",
      "format": "uuid",
      "minLength": 36,
      "maxLength": 36,
      "tsType": "Brand<string, 'AssetId'>"
    },
    "BriefId": {
      "type": "string",
      "format": "uuid",
      "minLength": 36,
      "maxLength": 36,
      "tsType": "Brand<string, 'BriefId'>"
    },
    "ResearchFact": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "fact_id": {
          "$ref": "https://schemas.jevelopers.org/EventIntelligencePackage/1.0.0#/$defs/FactId",
          "x-classification": "restricted"
        },
        "revision": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991,
          "x-classification": "restricted"
        },
        "fact_hash": {
          "$ref": "https://schemas.jevelopers.org/CommonEnvelope/1.0.0#/$defs/Sha256",
          "x-classification": "restricted"
        },
        "key": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{1,64}$",
          "x-classification": "restricted"
        },
        "status": {
          "type": "string",
          "enum": [
            "known",
            "unknown",
            "conflicting",
            "review"
          ],
          "x-classification": "restricted"
        },
        "value": {
          "anyOf": [
            {
              "$ref": "https://schemas.jevelopers.org/DecisionPortRequest/1.0.0#/$defs/InertValue"
            },
            {
              "type": "null"
            }
          ],
          "x-classification": "restricted"
        },
        "candidate_values": {
          "type": "array",
          "items": {
            "$ref": "https://schemas.jevelopers.org/DecisionPortRequest/1.0.0#/$defs/InertValue"
          },
          "maxItems": 10,
          "minItems": 0,
          "x-classification": "restricted"
        },
        "confidence": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "basis": {
              "type": "string",
              "enum": [
                "sourced",
                "heuristic",
                "not_measured"
              ],
              "x-classification": "restricted"
            },
            "value": {
              "anyOf": [
                {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 1
                },
                {
                  "type": "null"
                }
              ],
              "x-classification": "restricted"
            }
          },
          "required": [
            "basis",
            "value"
          ],
          "x-classification": "restricted"
        },
        "provenance": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "source_id": {
                "type": "string",
                "pattern": "^[A-Za-z0-9_-]{1,64}$",
                "x-classification": "restricted"
              },
              "retrieved_at": {
                "$ref": "https://schemas.jevelopers.org/CommonEnvelope/1.0.0#/$defs/UtcTime",
                "x-classification": "restricted"
              },
              "evidence_ref": {
                "$ref": "https://schemas.jevelopers.org/ErrorEnvelope/1.0.0#/$defs/VersionedReference",
                "x-classification": "restricted"
              }
            },
            "required": [
              "source_id",
              "retrieved_at",
              "evidence_ref"
            ]
          },
          "maxItems": 20,
          "minItems": 1,
          "x-classification": "restricted"
        }
      },
      "required": [
        "fact_id",
        "revision",
        "fact_hash",
        "key",
        "status",
        "value",
        "candidate_values",
        "confidence",
        "provenance"
      ]
    },
    "AssetCandidate": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "asset_id": {
          "$ref": "https://schemas.jevelopers.org/EventIntelligencePackage/1.0.0#/$defs/AssetId",
          "x-classification": "restricted"
        },
        "revision": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991,
          "x-classification": "restricted"
        },
        "source_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{1,64}$",
          "x-classification": "restricted"
        },
        "original_hash": {
          "$ref": "https://schemas.jevelopers.org/CommonEnvelope/1.0.0#/$defs/Sha256",
          "x-classification": "restricted"
        },
        "transformed_hash": {
          "anyOf": [
            {
              "$ref": "https://schemas.jevelopers.org/CommonEnvelope/1.0.0#/$defs/Sha256"
            },
            {
              "type": "null"
            }
          ],
          "x-classification": "restricted"
        },
        "media_type": {
          "type": "string",
          "enum": [
            "image/png",
            "image/jpeg",
            "image/webp"
          ],
          "x-classification": "restricted"
        },
        "discovery_url": {
          "type": "string",
          "pattern": "^https?://[^\\s]+$",
          "maxLength": 2048,
          "x-classification": "restricted"
        }
      },
      "required": [
        "asset_id",
        "revision",
        "source_id",
        "original_hash",
        "transformed_hash",
        "media_type",
        "discovery_url"
      ]
    },
    "ApprovedAsset": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "asset_id": {
          "$ref": "https://schemas.jevelopers.org/EventIntelligencePackage/1.0.0#/$defs/AssetId",
          "x-classification": "restricted"
        },
        "revision": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991,
          "x-classification": "restricted"
        },
        "artifact_ref": {
          "$ref": "https://schemas.jevelopers.org/ErrorEnvelope/1.0.0#/$defs/VersionedReference",
          "x-classification": "restricted"
        },
        "original_hash": {
          "$ref": "https://schemas.jevelopers.org/CommonEnvelope/1.0.0#/$defs/Sha256",
          "x-classification": "restricted"
        },
        "transformed_hash": {
          "anyOf": [
            {
              "$ref": "https://schemas.jevelopers.org/CommonEnvelope/1.0.0#/$defs/Sha256"
            },
            {
              "type": "null"
            }
          ],
          "x-classification": "restricted"
        },
        "intended_use": {
          "type": "string",
          "enum": [
            "display",
            "reproduce",
            "modify",
            "publish"
          ],
          "x-classification": "restricted"
        },
        "approval_ref": {
          "$ref": "https://schemas.jevelopers.org/ErrorEnvelope/1.0.0#/$defs/VersionedReference",
          "x-classification": "restricted"
        },
        "expires_at": {
          "$ref": "https://schemas.jevelopers.org/CommonEnvelope/1.0.0#/$defs/UtcTime",
          "x-classification": "restricted"
        }
      },
      "required": [
        "asset_id",
        "revision",
        "artifact_ref",
        "original_hash",
        "transformed_hash",
        "intended_use",
        "approval_ref",
        "expires_at"
      ]
    }
  }
}
