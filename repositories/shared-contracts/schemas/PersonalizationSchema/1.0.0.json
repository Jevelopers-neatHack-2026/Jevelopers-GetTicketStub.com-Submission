{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.jevelopers.org/PersonalizationSchema/1.0.0",
  "title": "PersonalizationSchema",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "contract": {
      "const": "PersonalizationSchema",
      "x-classification": "public"
    },
    "schema_version": {
      "const": "1.0.0",
      "x-classification": "public"
    },
    "policy_version": {
      "const": "1.0.0",
      "x-classification": "public"
    },
    "tenant_id": {
      "$ref": "https://schemas.jevelopers.org/CommonEnvelope/1.0.0#/$defs/TenantId",
      "x-classification": "restricted"
    },
    "project_id": {
      "$ref": "https://schemas.jevelopers.org/CommonEnvelope/1.0.0#/$defs/ProjectId",
      "x-classification": "restricted"
    },
    "schema_id": {
      "type": "string",
      "format": "uuid",
      "x-classification": "restricted",
      "minLength": 36,
      "maxLength": 36
    },
    "revision": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991,
      "x-classification": "restricted"
    },
    "content_hash": {
      "$ref": "https://schemas.jevelopers.org/CommonEnvelope/1.0.0#/$defs/Sha256",
      "x-classification": "restricted",
      "type": "string",
      "minLength": 71,
      "maxLength": 71
    },
    "fields": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "field_id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_.:-]{1,100}(?![\\s\\S])",
            "x-classification": "restricted"
          },
          "slot_id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_.:-]{1,100}(?![\\s\\S])",
            "x-classification": "restricted"
          },
          "required": {
            "type": "boolean",
            "x-classification": "restricted"
          },
          "maximum_utf16_units": {
            "type": "integer",
            "minimum": 1,
            "maximum": 4096,
            "x-classification": "restricted"
          },
          "source_policy": {
            "type": "string",
            "enum": [
              "row_display",
              "approved_fact_readonly"
            ],
            "x-classification": "restricted"
          }
        },
        "required": [
          "field_id",
          "slot_id",
          "required",
          "maximum_utf16_units",
          "source_policy"
        ],
        "x-classification": "restricted"
      },
      "minItems": 1,
      "maxItems": 32,
      "x-classification": "restricted"
    },
    "limits": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "maximum_rows": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10000,
          "x-classification": "restricted"
        },
        "maximum_canonical_bytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 4000000,
          "x-classification": "restricted"
        },
        "maximum_fields": {
          "type": "integer",
          "minimum": 1,
          "maximum": 32,
          "x-classification": "restricted"
        }
      },
      "required": [
        "maximum_rows",
        "maximum_canonical_bytes",
        "maximum_fields"
      ],
      "x-classification": "restricted"
    }
  },
  "required": [
    "contract",
    "schema_version",
    "policy_version",
    "tenant_id",
    "project_id",
    "schema_id",
    "revision",
    "content_hash",
    "fields",
    "limits"
  ],
  "x-classification": "restricted"
}
