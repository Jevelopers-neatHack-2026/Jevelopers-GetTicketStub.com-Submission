{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.jevelopers.org/ArtifactRef/1.0.0",
  "title": "ArtifactRef",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "contract": {
      "const": "ArtifactRef",
      "x-classification": "public"
    },
    "schema_version": {
      "const": "1.0.0",
      "x-classification": "public"
    },
    "policy_version": {
      "const": "1.0.0",
      "x-classification": "public"
    },
    "artifact_ref": {
      "allOf": [
        {
          "$ref": "https://schemas.jevelopers.org/ProductionReference/1.0.0#/$defs/Reference",
          "x-classification": "restricted"
        },
        {
          "type": "object",
          "properties": {
            "contract": {
              "const": "ArtifactFile",
              "x-classification": "public"
            },
            "schema_version": {
              "const": "2.0.0",
              "x-classification": "public"
            }
          },
          "required": [
            "contract",
            "schema_version"
          ]
        }
      ],
      "x-classification": "restricted"
    },
    "composition_ref": {
      "allOf": [
        {
          "$ref": "https://schemas.jevelopers.org/ProductionReference/1.0.0#/$defs/Reference",
          "x-classification": "restricted"
        },
        {
          "type": "object",
          "properties": {
            "contract": {
              "const": "Composition",
              "x-classification": "public"
            },
            "schema_version": {
              "const": "1.0.0",
              "x-classification": "public"
            }
          },
          "required": [
            "contract",
            "schema_version"
          ]
        }
      ],
      "x-classification": "restricted"
    },
    "private_revision_hash": {
      "$ref": "https://schemas.jevelopers.org/CommonEnvelope/1.0.0#/$defs/Sha256",
      "x-classification": "restricted",
      "type": "string",
      "minLength": 71,
      "maxLength": 71
    },
    "source_artwork_hashes": {
      "type": "array",
      "items": {
        "$ref": "https://schemas.jevelopers.org/CommonEnvelope/1.0.0#/$defs/Sha256",
        "x-classification": "restricted",
        "type": "string",
        "minLength": 71,
        "maxLength": 71
      },
      "minItems": 1,
      "maxItems": 100,
      "x-classification": "restricted"
    },
    "render_hash": {
      "$ref": "https://schemas.jevelopers.org/CommonEnvelope/1.0.0#/$defs/Sha256",
      "x-classification": "restricted",
      "type": "string",
      "minLength": 71,
      "maxLength": 71
    },
    "preview_ref": {
      "anyOf": [
        {
          "allOf": [
            {
              "$ref": "https://schemas.jevelopers.org/ProductionReference/1.0.0#/$defs/Reference",
              "x-classification": "restricted"
            },
            {
              "type": "object",
              "properties": {
                "contract": {
                  "const": "ArtifactFile",
                  "x-classification": "public"
                },
                "schema_version": {
                  "const": "2.0.0",
                  "x-classification": "public"
                }
              },
              "required": [
                "contract",
                "schema_version"
              ]
            }
          ],
          "x-classification": "restricted"
        },
        {
          "type": "null"
        }
      ],
      "x-classification": "restricted"
    }
  },
  "required": [
    "contract",
    "schema_version",
    "policy_version",
    "artifact_ref",
    "composition_ref",
    "private_revision_hash",
    "source_artwork_hashes",
    "render_hash",
    "preview_ref"
  ],
  "x-classification": "restricted"
}
