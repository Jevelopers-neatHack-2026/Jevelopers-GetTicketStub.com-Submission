{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.jevelopers.org/ArtifactStatusRequest/1.0.0",
  "title": "ArtifactStatusRequest",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "contract": {
      "const": "ArtifactStatusRequest",
      "x-classification": "public"
    },
    "schema_version": {
      "const": "1.0.0",
      "x-classification": "public"
    },
    "policy_version": {
      "const": "1.0.0",
      "x-classification": "public"
    },
    "request_id": {
      "$ref": "https://schemas.jevelopers.org/CommonEnvelope/1.0.0#/$defs/EventId",
      "x-classification": "restricted"
    },
    "correlation_id": {
      "$ref": "https://schemas.jevelopers.org/CommonEnvelope/1.0.0#/$defs/CorrelationId",
      "x-classification": "restricted"
    },
    "target": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "artifact",
              "x-classification": "public"
            },
            "artifact_ref": {
              "$ref": "https://schemas.jevelopers.org/ArtifactRef/1.0.0",
              "x-classification": "restricted"
            }
          },
          "required": [
            "kind",
            "artifact_ref"
          ],
          "x-classification": "restricted"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "job",
              "x-classification": "public"
            },
            "job_ref": {
              "$ref": "https://schemas.jevelopers.org/JobRef/1.0.0",
              "x-classification": "restricted"
            }
          },
          "required": [
            "kind",
            "job_ref"
          ],
          "x-classification": "restricted"
        }
      ],
      "x-classification": "restricted"
    },
    "page": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "cursor": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 1024,
              "x-classification": "restricted"
            },
            {
              "type": "null"
            }
          ],
          "x-classification": "restricted"
        },
        "limit": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100,
          "x-classification": "restricted"
        }
      },
      "required": [
        "cursor",
        "limit"
      ],
      "x-classification": "restricted"
    }
  },
  "required": [
    "contract",
    "schema_version",
    "policy_version",
    "request_id",
    "correlation_id",
    "target"
  ],
  "x-classification": "restricted"
}
