  "required": [
    "contract",
    "schema_version",
    "policy_version",
    "event_id",
    "tenant_id",
    "project_id",
    "correlation_id",
    "producer",
    "occurred_at",
    "observed_at",
    "ingested_at",
    "environment",
    "billing_mode",
    "source_refs",
    "job_id",
    "request_id",
    "idempotency_key",
    "command",
    "expected_revision",
    "requested_at",
    "reason_code"
  ]
