# Copy to .env (git-ignored, chmod 600) for owner-approved local sandbox checks only.
# Placeholder names only; never commit real values.
#
# Prodigi Print API v4 SANDBOX key (https://api.sandbox.prodigi.com/v4.0).
# Resolved through the secret reference `prodigi/sandbox/api-key`.
PRODIGI_SANDBOX_API_KEY=
#
# There is intentionally no live Prodigi key binding. Live ordering is a
# separate future launch step and is refused by the secret resolver.
