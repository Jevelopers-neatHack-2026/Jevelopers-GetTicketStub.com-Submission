# Copy to .env.local. Secrets stay server-side; never use NEXT_PUBLIC_ names.
# Demo preview is the default and does not call providers even with keys present.
TICKETSTUB_RUNTIME_MODE=demo

# Select each capability independently: anthropic/openrouter for research and
# agent; openai/openrouter for art. The default is the original direct provider.
TICKETSTUB_RESEARCH_PROVIDER=anthropic
TICKETSTUB_AGENT_PROVIDER=anthropic
TICKETSTUB_ART_PROVIDER=openai

# Required only when that capability selects openrouter. Choose exact model IDs
# from https://openrouter.ai/models (no auto/online/fallback variants).
TICKETSTUB_RESEARCH_MODEL=
TICKETSTUB_AGENT_MODEL=
TICKETSTUB_ART_MODEL=
# Each selected model uses its own key. There is no shared-key fallback.
TICKETSTUB_RESEARCH_OPENROUTER_API_KEY=
TICKETSTUB_AGENT_OPENROUTER_API_KEY=
TICKETSTUB_ART_OPENROUTER_API_KEY=

# Required only for selected direct-provider paths.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Signing keys (integration-evals decision 0003, K4). Each token class has its own key.
# CONTEXT_SECRET: one key, no kid, for five-minute context tokens only. 32+ random characters.
CONTEXT_SECRET=
# APPROVAL_SIGNING_KEYS: artwork approval tokens. Versioned JSON, one line, exactly one active key:
#   {"v":1,"keys":[{"kid":"approval-g1","state":"active","activatedAt":"<ISO time>","key":"<base64url of 32 random bytes>"}]}
# Rotate by adding the new key as active and marking the old one retired with retiredAt; keep the
# retired entry for 7 days (the approval token lifetime) so tokens already handed out keep verifying.
# Never reuse CONTEXT_SECRET or another key set's bytes. Unset in live mode: approvals answer 503.
APPROVAL_SIGNING_KEYS=
# ORDER_AUTH_SIGNING_KEYS: order-authorization tokens. Same JSON shape, its own keys (kid e.g. order-auth-g1).
# A retired key keeps verifying for 15 minutes (the token lifetime). Unset in live mode: issuing answers 503.
ORDER_AUTH_SIGNING_KEYS=
# ORDER_AUTH_CONSUMER_KEY: signs consumer requests to /api/order-authorizations/* only, never tokens.
# 32+ random characters, different from every key above. Unset: the consumer port answers 503.
ORDER_AUTH_CONSUMER_KEY=
