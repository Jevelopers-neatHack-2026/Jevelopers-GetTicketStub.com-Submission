# Copy to .env.local. Secrets stay server-side; never use NEXT_PUBLIC_ names.
# Demo preview is the default and does not call providers even with keys present.
TICKETSTUB_RUNTIME_MODE=demo

# Select each capability independently: anthropic/openrouter for research and
# agent; openai/openrouter for art. The default is the original direct provider.
TICKETSTUB_RESEARCH_PROVIDER=anthropic
TICKETSTUB_AGENT_PROVIDER=anthropic
TICKETSTUB_ART_PROVIDER=openai

# Required only when that capability selects openrouter. Choose exact model IDs
# from https://openrouter.ai/models (no auto/online/fallback variants).
TICKETSTUB_RESEARCH_MODEL=
TICKETSTUB_AGENT_MODEL=
TICKETSTUB_ART_MODEL=
# Each selected model uses its own key. There is no shared-key fallback.
TICKETSTUB_RESEARCH_OPENROUTER_API_KEY=
TICKETSTUB_AGENT_OPENROUTER_API_KEY=
TICKETSTUB_ART_OPENROUTER_API_KEY=

# Required only for selected direct-provider paths.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Open-Meteo API Standard subscription key (dashboard.open-meteo.com), server secret only. Set = weather and
# place lookups use the commercial customer endpoints; blank = the free tier, which is for evaluation only and
# not licensed for commercial use. The plan has no historical weather: dates more than 92 days back stay pending.
OPEN_METEO_API_KEY=

# Product analytics (GA4, docs/operations/analytics.md). Off unless BOTH are set, and nothing loads in
# a browser until the visitor agrees. Read per request by the server: change and restart, no rebuild.
# The measurement id is public page configuration, not a secret. Give preview its own GA4 property.
# production | preview
TICKETSTUB_ANALYTICS_ENV=
# G-XXXXXXXXXX from the property's web data stream
TICKETSTUB_GA_MEASUREMENT_ID=
# 1 = mark events for GA DebugView (designated test property only)
TICKETSTUB_GA_DEBUG=
# 1 = kill switch: no consent card, no script, no events, whatever else is set
TICKETSTUB_ANALYTICS_DISABLED=

# Server operational measurement (separate from browser analytics consent). Default off.
# off | log | neatlogs | log,neatlogs   (log = one sanitized JSON line per event on stdout, schema ticketstub.ops/1;
# neatlogs = one content-free Neatlogs trace per AI route request, needs NEATLOGS_API_KEY)
TICKETSTUB_OPS_TELEMETRY=off
# Neatlogs project API key (Settings > API keys), server secret only. Sent only as x-api-key to the ingest origin.
NEATLOGS_API_KEY=
# Blank = US https://ingest.neatlogs.com; EU projects use https://eu.ingest.neatlogs.com
NEATLOGS_ENDPOINT=
# Optional short or full commit SHA of the deployed build, added as a ticketstub@<sha> trace tag
TICKETSTUB_COMMIT_SHA=
# production | preview | development | test — labels events so preview/demo traffic is never read as production
TICKETSTUB_OPS_ENVIRONMENT=

# Staff access: comma-separated verified account emails that get /admin and POST /api/admin/backup.
ADMIN_EMAILS=
# Signs 5-minute context tokens (HMAC-SHA256), 32+ characters, e.g. `openssl rand -hex 32`.
# Required in live mode (otherwise /api/context answers 503). Never the fixture key in fixtures/context.
CONTEXT_SECRET=
# Days between automatic backups to <db folder>/backups (default 7; 0 or off disables). Needs TICKETSTUB_DB and TICKETSTUB_FILES.
TICKETSTUB_BACKUP_EVERY_DAYS=
