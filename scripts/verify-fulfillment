#!/usr/bin/env node
import { mkdir, writeFile } from "node:fs/promises";
import path from "node:path";

let allSharedShapes = [];
let contractOwnership = {};
let catalogAvailable = false;
let catalogApiAvailable = false;
let providerEnvironmentMatrix = null;
try {
  const catalog = await import("../dist/index.js");
  allSharedShapes = catalog.ALL_SHARED_SHAPES;
  contractOwnership = catalog.CONTRACT_OWNERSHIP;
  providerEnvironmentMatrix = catalog.PROVIDER_ENVIRONMENT_MATRIX ?? null;
  catalogAvailable = Array.isArray(allSharedShapes) && contractOwnership !== undefined;
  catalogApiAvailable = typeof catalog.normalizeCatalogSnapshot === "function"
    && typeof catalog.discoverCatalogSnapshot === "function"
    && typeof catalog.evaluateCatalogSelection === "function"
    && typeof catalog.validateCatalogSnapshotBoundary === "function";
} catch {
  // Keep argument and missing-build failures machine-readable even before a build.
}

function parseArgs(argv) {
  const parsed = {};
  for (let index = 0; index < argv.length; index += 1) {
    const key = argv[index];
    if (!["--suite", "--mode", "--evidence-dir"].includes(key)) {
      parsed.argumentError = "unknown_argument";
      continue;
    }
    const value = argv[index + 1];
    if (value === undefined || value.startsWith("--")) {
      parsed.argumentError = "missing_argument_value";
      continue;
    }
    parsed[key.slice(2)] = value;
    index += 1;
  }
  return parsed;
}

const args = parseArgs(process.argv.slice(2));
const allowedSuites = new Set(["contract", "provider-matrix", "security", "catalog", "sandbox", "release"]);
const allowedModes = new Set(["simulated", "sandbox"]);
const startedAt = new Date().toISOString();
const missingAcceptedPins = allSharedShapes.map((shape) => ({
  shape,
  ownerRepository: contractOwnership[shape]?.ownerRepository ?? null,
  upstreamIssue: contractOwnership[shape]?.upstreamIssue ?? null,
  state: "missing",
  schemaVersion: null,
  sourceRevision: null,
  fixtureDigest: null
}));
const blockers = [
  "accepted upstream schema versions, source revisions, and fixture digests are missing",
  "producer and consumer conformance reports are missing"
];
const securityBlockers = [
  "accepted shared-contracts SC8 artifact and pin are missing",
  "encrypted scoped storage, key management, retention execution, and deletion audit are not implemented",
  "a production server-side secret manager and credential-rotation evidence are unavailable",
  "DNS-pinned asset transport, TLS peer enforcement, redirect cleanup, and production host policy are injected-port requirements only",
  "durable callback replay storage and a selected provider's documented authenticity method are unavailable",
  "sandbox account access, a selected adapter, and genuine private provider fixtures are unavailable",
  "producer/consumer conformance and genuine release evidence remain missing"
];
const catalogBlockers = [
  "shared-contracts #4 has not accepted and published the canonical capability/print-spec shape, schema version, source revision, and fixture digest",
  "print-production #6 has not reviewed or acknowledged the catalog snapshot mapping and expected results",
  "the exact provider SKU/specification, destination, and shipping choice remain owner review inputs"
];

let checks = [];
let failureReasons = [];
let status = "failed";

if (args.argumentError !== undefined) failureReasons.push(args.argumentError);
if (args.suite === undefined) failureReasons.push("suite_required");
else if (!allowedSuites.has(args.suite)) failureReasons.push("unknown_suite");
if (args.mode === undefined) failureReasons.push("mode_required");
else if (!allowedModes.has(args.mode)) failureReasons.push("invalid_mode");
if (args["evidence-dir"] === undefined) failureReasons.push("evidence_dir_required");
if (process.version !== "v24.15.0") failureReasons.push("runtime_version_mismatch");
if (args.suite === "provider-matrix" && args.mode !== "simulated") failureReasons.push("provider_matrix_requires_simulated_mode");
if (args.suite === "security" && args.mode !== "simulated") failureReasons.push("security_suite_requires_simulated_mode");
if (args.suite === "catalog" && args.mode !== "simulated" && allowedModes.has(args.mode)) failureReasons.push("catalog_suite_requires_simulated_mode");

if (failureReasons.length === 0 && args.suite === "contract" && args.mode === "simulated") {
  if (!catalogAvailable) failureReasons.push("runtime_build_prerequisite_missing");
  try {
    if (failureReasons.length === 0) {
      const { runContractSuite } = await import("../tests/contract-suite.mjs");
      checks = await runContractSuite();
      if (checks.length > 0 && checks.every((check) => check.status === "passed")) {
        status = "passed";
      } else {
        failureReasons.push("one_or_more_local_fixture_checks_failed");
      }
    }
  } catch {
    failureReasons.push("contract_suite_prerequisite_failed");
  }
} else if (failureReasons.length === 0 && args.suite === "contract") {
  failureReasons.push("contract_fixture_suite_requires_simulated_mode");
} else if (failureReasons.length === 0 && args.suite === "provider-matrix" && args.mode === "simulated") {
  if (!catalogAvailable || providerEnvironmentMatrix === null) failureReasons.push("provider_matrix_build_prerequisite_missing");
  try {
    if (failureReasons.length === 0) {
      const { runProviderMatrixSuite } = await import("../tests/provider-matrix-suite.mjs");
      checks = await runProviderMatrixSuite();
      if (checks.length > 0 && checks.every((check) => check.status === "passed")) {
        status = "passed";
      } else {
        failureReasons.push("one_or_more_provider_matrix_checks_failed");
      }
    }
  } catch {
    failureReasons.push("provider_matrix_suite_prerequisite_failed");
  }
} else if (failureReasons.length === 0 && args.suite === "security" && args.mode === "simulated") {
  if (!catalogAvailable) failureReasons.push("security_build_prerequisite_missing");
  try {
    if (failureReasons.length === 0) {
      const { runSecuritySuite } = await import("../tests/security-suite.mjs");
      checks = await runSecuritySuite();
      if (checks.length > 0 && checks.every((check) => check.status === "passed")) {
        status = "passed";
      } else {
        failureReasons.push("one_or_more_local_security_checks_failed");
      }
    }
  } catch {
    failureReasons.push("security_suite_prerequisite_failed");
  }
} else if (failureReasons.length === 0 && args.suite === "catalog" && args.mode === "simulated") {
  if (!catalogAvailable || !catalogApiAvailable) failureReasons.push("catalog_build_prerequisite_missing");
  try {
    if (failureReasons.length === 0) {
      const { runCatalogSuite } = await import("../tests/catalog-suite.mjs");
      checks = await runCatalogSuite();
      if (checks.length > 0 && checks.every((check) => check.status === "passed")) {
        status = "passed";
      } else {
        failureReasons.push("one_or_more_local_catalog_checks_failed");
      }
    }
  } catch {
    failureReasons.push("catalog_suite_prerequisite_failed");
  }
} else if (failureReasons.length === 0 && args.suite === "sandbox") {
  failureReasons.push("sandbox_adapter_and_accepted_contract_pins_unavailable");
} else if (failureReasons.length === 0 && args.suite === "release") {
  failureReasons.push("release_evidence_and_cross_repository_conformance_unavailable");
}

const result = {
  schemaVersion: "fulfillment-verification-result/1",
  suite: args.suite ?? null,
  mode: args.mode ?? null,
  billing_mode: args.mode ?? null,
  status,
  startedAt,
  completedAt: new Date().toISOString(),
  runtime: {
    node: process.version,
    expectedNode: "24.15.0",
    package: "@jevelopers/fulfillment-connectors@0.1.0",
    liveModeSupported: false
  },
  scope: status === "passed"
    ? args.suite === "provider-matrix"
      ? "local_private_provider_matrix_suite"
      : args.suite === "security"
        ? "local_private_security_policy_suite"
        : args.suite === "catalog"
          ? "local_private_catalog_fixture_suite"
          : "local_private_fixture_contract_suite"
    : "argument_or_prerequisite_check",
  checks,
  failureReasons,
  blockers: [
    ...blockers,
    ...(args.suite === "catalog" ? catalogBlockers : []),
    ...(args.suite === "provider-matrix" ? [
      "print-production has not selected and approved an actual Prodigi SKU and print specification",
      "destination and shipping method have not been selected or approved",
      "sandbox account access and sandbox credentials have not been verified",
      "no Prodigi adapter or account-tested provider behavior is implemented",
      "quote expiry and callback authenticity policy remain unverified",
      "producer and consumer conformance and release evidence remain missing"
    ] : []),
    ...(args.suite === "security" ? securityBlockers : []),
    ...(status === "passed" ? [] : failureReasons)
  ],
  contractPins: {
    catalogAvailable,
    releaseReady: false,
    missingAcceptedPins
  },
  conformance: {
    producerRepositoryRevision: null,
    consumerRepositoryRevision: null,
    expectedResultsMatch: false
  },
  providerMatrix: args.suite === "provider-matrix" ? providerEnvironmentMatrix : null,
  ...(args.suite === "catalog" ? {
    catalogAssessment: {
      schemaVersion: "fulfillment-catalog-assessment/1",
      evidenceScope: "private_offline_normalization_and_synthetic_fixtures_only",
      completion: "partial",
      localFixtureResult: status === "passed" ? "passed" : checks.length === 0 ? "not_run" : "failed",
      localFixtureCounts: {
        total: checks.length,
        passed: checks.filter((check) => check.status === "passed").length,
        failed: checks.filter((check) => check.status !== "passed").length
      },
      fc03_1: "partial_private_capability_and_print_spec_normalization",
      fc03_2: "partial_private_versioned_snapshots_freshness_and_revalidation",
      fc03_3: "partial_incompatible_synthetic_fixtures; selected_provider_product_and_consumer_review_pending",
      privateInputFormat: "connector-development-catalog/1",
      privateSnapshotFormat: "connector-development-catalog-snapshot/1",
      acceptedSharedContract: {
        ownerRepository: "shared-contracts",
        upstreamIssue: "#4",
        state: "pending",
        schemaVersion: null,
        sourceRevision: null,
        fixtureDigest: null
      },
      consumerReview: {
        repository: "print-production",
        issue: "#6",
        state: "pending",
        sourceRevision: null,
        expectedResultsMatch: false
      },
      sandbox: {
        selectedProviderSku: null,
        selectedDestination: null,
        selectedShippingMethod: null,
        accountAccess: "unknown",
        adapter: "not_implemented",
        sandboxReady: false
      },
      liveEnabled: false,
      releaseReady: false,
      artifactConstruction: "not_performed",
      externalProviderCalls: 0,
      blockers: catalogBlockers
    }
  } : {}),
  providerMatrixAssessment: args.suite === "provider-matrix" ? {
    schemaVersion: "fulfillment-provider-matrix-assessment/1",
    evidenceScope: "documented_metadata_and_private_policy_fixtures_only",
    completion: "partial",
    fc02_1: "partial_documented_matrix",
    fc02_2: "blocked_pending_owner_product_and_account_evidence",
    documentationRevision: providerEnvironmentMatrix?.documentationRevision ?? "unknown",
    observedSnapshotDigest: providerEnvironmentMatrix?.observedSnapshotDigest ?? null,
    selectedProdigiSku: null,
    selectedDestinationCountryCode: null,
    selectedShippingMethod: null,
    sandboxAccountAccess: "unknown",
    sandboxAdapter: "not_implemented",
    sandboxReady: false,
    liveEnabled: false,
    otherProviders: "deferred",
    blockers: [
      "print-production has not selected and approved an actual Prodigi SKU and print specification",
      "destination and shipping method have not been selected or approved",
      "sandbox account access and sandbox credentials have not been verified",
      "no Prodigi adapter or account-tested provider behavior is implemented",
      "quote expiry and callback authenticity policy remain unverified",
      "producer and consumer conformance and release evidence remain missing"
    ]
  } : null,
  ...(args.suite === "security" ? {
    securityAssessment: {
      schemaVersion: "fulfillment-security-assessment/1",
      evidenceScope: "private_policy_helpers_and_synthetic_injected_ports_only",
      completion: "partial",
      localFixtureResult: status === "passed" ? "passed" : checks.length === 0 ? "not_run" : "failed",
      fc11_1: "partial_local_helpers; accepted_SC8_encrypted_store_key_lifecycle_and_retention_execution_pending",
      fc11_2: "partial_local_helpers; production_secret_manager_and_pinned_asset_transport_pending",
      fc11_3: "partial_local_helpers; provider_callback_authenticity_and_durable_replay_pending",
      acceptedSharedContractSC8: "missing",
      encryptedStorage: "not_implemented",
      secretManager: "not_implemented",
      pinnedAssetTransport: "injected_port_only",
      callbackReplayStore: "injected_port_only",
      providerCallbackVerifier: "not_implemented",
      sandboxReady: false,
      liveEnabled: false,
      releaseReady: false,
      externalProviderCalls: 0,
      blockers: securityBlockers
    }
  } : {}),
  externalProviderCalls: 0,
  evidenceFile: null
};

if (args["evidence-dir"] !== undefined) {
  const evidenceDir = path.resolve(args["evidence-dir"]);
  const evidenceFile = path.join(evidenceDir, "result.json");
  result.evidenceFile = evidenceFile;
  result.completedAt = new Date().toISOString();
  try {
    await mkdir(evidenceDir, { recursive: true });
    await writeFile(evidenceFile, `${JSON.stringify(result, null, 2)}\n`, { encoding: "utf8", flag: "w" });
  } catch {
    status = "failed";
    result.status = status;
    result.scope = "argument_or_prerequisite_check";
    failureReasons.push("evidence_write_failed");
    result.failureReasons = failureReasons;
    result.blockers = [
      ...blockers,
      ...(args.suite === "security" ? securityBlockers : []),
      ...(args.suite === "catalog" ? catalogBlockers : []),
      ...failureReasons
    ];
    if (result.catalogAssessment !== undefined) result.catalogAssessment.localFixtureResult = "failed";
  }
}
process.stdout.write(`${JSON.stringify(result, null, 2)}\n`);
if (status !== "passed") process.exitCode = 1;
