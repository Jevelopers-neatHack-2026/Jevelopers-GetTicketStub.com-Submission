if (args["evidence-dir"] !== undefined) {
  const evidenceDir = path.resolve(args["evidence-dir"]);
  const evidenceFile = path.join(evidenceDir, "result.json");
  result.evidenceFile = evidenceFile;
  result.completedAt = new Date().toISOString();
  try {
    await mkdir(evidenceDir, { recursive: true });
    await writeFile(evidenceFile, `${JSON.stringify(result, null, 2)}\n`, { encoding: "utf8", flag: "w" });
  } catch {
    status = "failed";
    result.status = status;
    result.scope = "argument_or_prerequisite_check";
    failureReasons.push("evidence_write_failed");
    result.failureReasons = failureReasons;
    result.blockers = [
      ...blockers,
      ...(args.suite === "security" ? securityBlockers : []),
      ...(args.suite === "catalog" ? catalogBlockers : []),
      ...(args.suite === "mock" ? mockBlockers : []),
      ...(args.suite === "quote" ? quoteBlockers : []),
      ...(args.suite === "comparison" ? comparisonBlockers : []),
      ...(args.suite === "attempt-store" ? attemptStoreBlockers : []),
      ...(args.suite === "status" ? statusBlockers : []),
      ...failureReasons
    ];
    if (result.catalogAssessment !== undefined) result.catalogAssessment.localFixtureResult = "failed";
    if (result.quoteAssessment !== undefined) result.quoteAssessment.localFixtureResult = "failed";
    if (result.comparisonAssessment !== undefined) {
      result.comparisonAssessment.localFixtureResult = "failed";
      result.comparisonAssessment.evidenceWriteStatus = "failed";
    }
    if (result.attemptStoreAssessment !== undefined) result.attemptStoreAssessment.localFixtureResult = "failed";
  }
}
process.stdout.write(`${JSON.stringify(result, null, 2)}\n`);
if (status !== "passed") process.exitCode = 1;
