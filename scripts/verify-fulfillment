    catalog.PRIVATE_COMPARISON_FORMAT === "connector-development-comparison/1";
  privateComparisonFormat = catalog.PRIVATE_COMPARISON_FORMAT ?? null;
  attemptStoreApiAvailable = typeof catalog.createLocalAttemptPersistence === "function" &&
    typeof catalog.LocalAttemptPersistence === "function" && typeof catalog.AttemptStoreError === "function";
  statusApiAvailable = typeof catalog.LocalStatusStore === "function" &&
    typeof catalog.StatusStoreError === "function" && typeof catalog.normalizeProviderObservation === "function" &&
    typeof catalog.fixtureStatusMapping === "function" && typeof catalog.fixtureTrackingHostPolicy === "function";
} catch {
  // Keep argument and missing-build failures machine-readable even before a build.
}

let simulatorFixtureVersion = null;
let simulatorProviderId = null;
let simulatorApiAvailable = false;
try {
  const simulator = await import("../dist/simulator.js");
  simulatorFixtureVersion = simulator.SIMULATOR_FIXTURE_VERSION ?? null;
  simulatorProviderId = simulator.SIMULATOR_PROVIDER_ID ?? null;
  simulatorApiAvailable = typeof simulator.createDeterministicSimulator === "function" &&
    typeof simulator.simulatorFixtureDigest === "function";
} catch {
  // Keep a missing simulator build machine-readable without masking argument errors.
}

function parseArgs(argv) {
  const parsed = {};
  for (let index = 0; index < argv.length; index += 1) {
    const key = argv[index];
    if (!["--suite", "--mode", "--evidence-dir"].includes(key)) {
      parsed.argumentError = "unknown_argument";
      continue;
    }
    const value = argv[index + 1];
    if (value === undefined || value.startsWith("--")) {
      parsed.argumentError = "missing_argument_value";
      continue;
    }
    parsed[key.slice(2)] = value;
    index += 1;
  }
  return parsed;
}

const args = parseArgs(process.argv.slice(2));
const allowedSuites = new Set(["contract", "provider-matrix", "security", "metering", "catalog", "mock", "quote", "attempt-store", "comparison", "status", "sandbox", "release"]);
const allowedModes = new Set(["simulated", "sandbox"]);
function validStatusRunnerReport(report) {
  const reportKeys = ["schemaVersion", "suite", "mode", "status", "passed", "failed", "results", "processExitCode",
    "processSignal", "processError", "stderrPresent", "externalProviderCalls", "orderCalls", "financeCalls", "skipped"];
  if (report === null || typeof report !== "object" || Array.isArray(report) ||
    Object.keys(report).sort().join("|") !== reportKeys.slice().sort().join("|") ||
    report.schemaVersion !== "fulfillment-status-suite-result/1" || report.suite !== "status" || report.mode !== "simulated" ||
    !["passed", "failed"].includes(report.status) || !Number.isSafeInteger(report.passed) || !Number.isSafeInteger(report.failed) ||
    !Array.isArray(report.results) || report.passed < 0 || report.failed < 0 || report.passed + report.failed !== report.results.length ||
    report.results.length < STATUS_SUITE_CASE_COUNT || !Number.isSafeInteger(report.processExitCode) && report.processExitCode !== null ||
    report.processSignal !== null && typeof report.processSignal !== "string" ||
    report.processError !== null && typeof report.processError !== "string" || typeof report.stderrPresent !== "boolean" ||
    report.externalProviderCalls !== 0 || report.orderCalls !== 0 || report.financeCalls !== 0 || report.skipped !== 0) return false;
  const names = new Set();
  for (const result of report.results) {
    if (result === null || typeof result !== "object" || Array.isArray(result) ||
      !["passed", "failed"].includes(result.status) || typeof result.name !== "string" || result.name.length === 0 ||
      names.has(result.name) || result.status === "failed" && typeof result.detail !== "string" ||
      Object.keys(result).some((key) => !["name", "status", "detail"].includes(key))) return false;
    names.add(result.name);
  }
  if (report.passed !== report.results.filter((result) => result.status === "passed").length ||
    report.failed !== report.results.filter((result) => result.status === "failed").length ||
    report.status !== (report.failed === 0 ? "passed" : "failed")) return false;
  if (report.failed === 0) {
    return report.results.length === STATUS_SUITE_CASE_COUNT && report.processExitCode === 0 &&
      report.processSignal === null && report.processError === null && report.stderrPresent === false;
  }
  return report.status === "failed";
}
